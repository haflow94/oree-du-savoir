<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<style>
@font-face { font-family: 'Spectral'; font-style: normal; font-weight: 400; src: url(file://{{fontsDir}}/spectral-400.woff2) format('woff2'); }
@font-face { font-family: 'Spectral'; font-style: normal; font-weight: 500; src: url(file://{{fontsDir}}/spectral-500.woff2) format('woff2'); }
@font-face { font-family: 'Spectral'; font-style: normal; font-weight: 600; src: url(file://{{fontsDir}}/spectral-600.woff2) format('woff2'); }
@font-face { font-family: 'Spectral'; font-style: italic; font-weight: 400; src: url(file://{{fontsDir}}/spectral-400-italic.woff2) format('woff2'); }
@font-face { font-family: 'Archivo'; font-style: normal; font-weight: 400 700; src: url(file://{{fontsDir}}/archivo-variable.woff2) format('woff2'); }
@font-face { font-family: 'IBM Plex Mono'; font-style: normal; font-weight: 400; src: url(file://{{fontsDir}}/ibm-plex-mono-400.woff2) format('woff2'); }
@font-face { font-family: 'IBM Plex Mono'; font-style: normal; font-weight: 500; src: url(file://{{fontsDir}}/ibm-plex-mono-500.woff2) format('woff2'); }
html, body { margin: 0; padding: 0; background: #fff; }
* { -webkit-print-color-adjust: exact; print-color-adjust: exact; box-sizing: border-box; }
.page { width: 210mm; height: 297mm; break-after: page; overflow: hidden; }
.page:last-child { break-after: auto; }
@page { size: A4; margin: 0; }
</style>
</head>
<body>

<div class="page" style="padding:12mm 15mm 10mm;background:#fff;font-family:Archivo,Helvetica,Arial,sans-serif;color:#1C1A17;display:flex;flex-direction:column">

  <div style="display:flex;align-items:flex-start;gap:6mm">
    <div style="flex:none;width:24mm;height:24mm;overflow:hidden;display:flex;align-items:center;justify-content:center">
      {{#if organisation.logoDataUri}}<img src="{{organisation.logoDataUri}}" alt="Logo de l'association" style="width:100%;height:100%;object-fit:contain;object-position:center" />{{/if}}
    </div>
    <div style="flex:1;padding-top:1.5mm">
      <div style="font-family:Spectral,Georgia,serif;font-weight:600;font-size:14.5pt;line-height:1.1;letter-spacing:.01em;color:#1F3D2B">{{organisation.nom}}</div>
      <div style="margin-top:1.2mm;font-size:6.8pt;letter-spacing:.15em;text-transform:uppercase;color:#7A7568">{{organisation.sousTitre}}</div>
    </div>
    <div style="flex:none;text-align:right;padding-top:1.5mm">
      <div style="font-size:6.2pt;letter-spacing:.14em;text-transform:uppercase;color:#7A7568">Année scolaire</div>
      <div style="margin-top:1mm;font-family:Spectral,Georgia,serif;font-size:12.5pt;font-weight:600;color:#1F3D2B">{{annee_scolaire}}</div>
    </div>
  </div>

  <div style="margin-top:5mm;height:0.8mm;background:#1F3D2B"></div>
  <div style="margin-top:0.7mm;height:0.3mm;background:#A98545"></div>

  <div style="margin-top:5mm;display:flex;align-items:flex-end;justify-content:space-between;gap:8mm">
    <div>
      <div style="font-size:7.5pt;letter-spacing:.3em;text-transform:uppercase;color:#7A7568">Dossier d'inscription · Mineur</div>
      <h1 style="margin:2mm 0 0;font-family:Spectral,Georgia,serif;font-weight:600;font-size:25pt;line-height:1.05;color:#1F3D2B">{{section_nom}}</h1>
    </div>
    <div style="flex:none;border:0.3mm solid #C9C3B6;border-left:0.9mm solid #A98545;background:#FAF8F3;padding:2.5mm 3.5mm;min-width:46mm">
      <div style="font-size:5.8pt;letter-spacing:.14em;text-transform:uppercase;color:#7A7568">Réservé à l'administration</div>
      <div style="margin-top:1.5mm;font-family:'IBM Plex Mono',monospace;font-size:7pt;color:#4A453D;line-height:1.8">N° dossier {{reference}}<br />Reçu le {{date_depot}}<br />Niveau d'admission {{niveau_admission}}</div>
    </div>
  </div>

  <div style="margin-top:8mm;display:flex;gap:8mm;align-items:flex-start">
    <div style="flex:1;min-width:0">
      <div style="display:flex;align-items:baseline;gap:3mm;border-bottom:0.5mm solid #1F3D2B;padding-bottom:1.5mm">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;font-weight:500;color:#A98545">01</span>
        <h2 style="margin:0;font-size:9pt;font-weight:600;letter-spacing:.17em;text-transform:uppercase;color:#1F3D2B">Informations personnelles de l'élève</h2>
      </div>
      <div style="margin-top:5mm;display:grid;grid-template-columns:repeat(12,1fr);gap:4.5mm 5mm">
        <label style="grid-column:span 6;display:flex;flex-direction:column;gap:1mm">
          <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Nom</span>
          <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{nom}}</span>
        </label>
        <label style="grid-column:span 6;display:flex;flex-direction:column;gap:1mm">
          <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Prénom</span>
          <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{prenom}}</span>
        </label>
        <div style="grid-column:span 4;display:flex;flex-direction:column;gap:1.5mm">
          <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Sexe</span>
          <div style="display:flex;gap:6mm;align-items:center;height:6.5mm">
            <span style="display:flex;gap:2mm;align-items:center;font-size:8.5pt"><span style="width:4mm;height:4mm;border:0.4mm solid #4A453D"></span>F</span>
            <span style="display:flex;gap:2mm;align-items:center;font-size:8.5pt"><span style="width:4mm;height:4mm;border:0.4mm solid #4A453D"></span>M</span>
          </div>
        </div>
        <label style="grid-column:span 8;display:flex;flex-direction:column;gap:1mm">
          <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Date et lieu de naissance</span>
          <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{date_naissance}} · {{lieu_naissance}}</span>
        </label>
        <label style="grid-column:span 12;display:flex;flex-direction:column;gap:1mm">
          <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Niveau scolaire</span>
          <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{niveau_scolaire}}</span>
        </label>
      </div>
    </div>

    <div style="flex:none;width:38mm">
      <div style="display:flex;align-items:baseline;gap:3mm;border-bottom:0.5mm solid #1F3D2B;padding-bottom:1.5mm">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;font-weight:500;color:#A98545">02</span>
        <h2 style="margin:0;font-size:9pt;font-weight:600;letter-spacing:.17em;text-transform:uppercase;color:#1F3D2B">Photo</h2>
      </div>
      <div style="margin-top:5mm;width:35mm;height:45mm;border:0.3mm dashed #B5AF9F;background:#FAF8F3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2mm;text-align:center;overflow:hidden">
        {{#if photoDataUri}}
        <img src="{{photoDataUri}}" alt="Photo de l'élève" style="width:100%;height:100%;object-fit:cover" />
        {{else}}
        <span style="font-size:7pt;color:#7A7568;line-height:1.4">Coller votre<br />photo ici</span>
        <span style="font-family:'IBM Plex Mono',monospace;font-size:5.5pt;color:#A49D8D">35 × 45 mm</span>
        {{/if}}
      </div>
    </div>
  </div>

  <div style="margin-top:7mm">
    <div style="display:flex;align-items:baseline;gap:3mm;border-bottom:0.5mm solid #1F3D2B;padding-bottom:1.5mm">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;font-weight:500;color:#A98545">03</span>
      <h2 style="margin:0;font-size:9pt;font-weight:600;letter-spacing:.17em;text-transform:uppercase;color:#1F3D2B">Horaire</h2>
    </div>
    <div style="margin-top:4.5mm;display:flex;gap:4mm;align-items:stretch">
      <div style="flex:1;max-width:62mm;border:0.3mm solid #C9C3B6;border-top:0.8mm solid #1F3D2B;padding:3.5mm;display:flex;gap:3mm;align-items:flex-start">
        <span style="flex:none;width:4.5mm;height:4.5mm;border:0.4mm solid #4A453D;margin-top:0.3mm"></span>
        <div style="font-size:8pt;line-height:1.45;color:#3A362F">{{creneau.jour}}<br /><span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;color:#1C1A17">{{creneau.horaire}}</span></div>
      </div>
      <div style="flex:1;display:grid;grid-template-columns:1fr 1fr;gap:4.5mm 5mm;align-content:end">
        <label style="display:flex;flex-direction:column;gap:1mm">
          <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Cours</span>
          <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{cours}}</span>
        </label>
        <label style="display:flex;flex-direction:column;gap:1mm">
          <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Classe</span>
          <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{classe}}</span>
        </label>
      </div>
    </div>
  </div>

  <div style="margin-top:7mm">
    <div style="display:flex;align-items:baseline;gap:3mm;border-bottom:0.5mm solid #1F3D2B;padding-bottom:1.5mm">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;font-weight:500;color:#A98545">04</span>
      <h2 style="margin:0;font-size:9pt;font-weight:600;letter-spacing:.17em;text-transform:uppercase;color:#1F3D2B">Responsable légal du mineur</h2>
    </div>
    <div style="margin-top:4.5mm;display:grid;grid-template-columns:repeat(12,1fr);gap:4.5mm 5mm">
      <label style="grid-column:span 6;display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Nom — Mr / Mme</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{rl_nom}}</span>
      </label>
      <label style="grid-column:span 6;display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Prénom</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{rl_prenom}}</span>
      </label>
      <div style="grid-column:span 12;display:flex;flex-direction:column;gap:1.5mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Relation</span>
        <div style="display:flex;gap:7mm;align-items:center;height:6mm">
          <span style="display:flex;gap:2mm;align-items:center;font-size:8.5pt"><span style="width:4mm;height:4mm;border:0.4mm solid #4A453D"></span>Père</span>
          <span style="display:flex;gap:2mm;align-items:center;font-size:8.5pt"><span style="width:4mm;height:4mm;border:0.4mm solid #4A453D"></span>Mère</span>
          <span style="display:flex;gap:2mm;align-items:center;font-size:8.5pt;flex:1"><span style="width:4mm;height:4mm;border:0.4mm solid #4A453D;flex:none"></span>Autre : <span style="flex:1;border-bottom:0.3mm solid #B5AF9F;font-family:'IBM Plex Mono',monospace;font-size:8pt;color:#1C1A17">{{rl_relation_autre}}</span></span>
        </div>
      </div>
      <label style="grid-column:span 12;display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Adresse</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{rl_adresse}}</span>
      </label>
      <label style="grid-column:span 4;display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Code postal</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{rl_code_postal}}</span>
      </label>
      <label style="grid-column:span 8;display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Ville</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{rl_ville}}</span>
      </label>
      <label style="grid-column:span 4;display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Tél.</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{rl_telephone}}</span>
      </label>
      <label style="grid-column:span 4;display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Mobile</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{rl_mobile}}</span>
      </label>
      <label style="grid-column:span 4;display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Tél. professionnel</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{rl_tel_pro}}</span>
      </label>
      <label style="grid-column:span 7;display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Adresse mail</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{rl_email}}</span>
      </label>
      <label style="grid-column:span 5;display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Profession</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{rl_profession}}</span>
      </label>
    </div>
  </div>

  <div style="margin-top:auto;padding-top:6mm;display:flex;justify-content:space-between;align-items:flex-end;gap:6mm;border-top:0.2mm solid #D5CFC2;font-size:5.8pt;color:#8A8477;line-height:1.6">
    <div style="font-family:'IBM Plex Mono',monospace">{{organisation.nom}} · {{organisation.adresseComplete}} · Tél. {{organisation.telephone}} · SIRET {{organisation.siret}} · NAF {{organisation.naf}}</div>
    <div style="flex:none;letter-spacing:.1em;text-transform:uppercase">Page 1 / 4</div>
  </div>
</div>

<div class="page" style="padding:12mm 15mm 10mm;background:#fff;font-family:Archivo,Helvetica,Arial,sans-serif;color:#1C1A17;display:flex;flex-direction:column">

  <div style="display:flex;align-items:baseline;justify-content:space-between;border-bottom:0.8mm solid #1F3D2B;padding-bottom:2.5mm">
    <div style="font-family:Spectral,Georgia,serif;font-size:10.5pt;font-weight:600;color:#1F3D2B">Dossier d'inscription — {{section_nom}}</div>
    <div style="font-size:6.8pt;letter-spacing:.14em;text-transform:uppercase;color:#7A7568">{{annee_scolaire}}</div>
  </div>

  <div style="margin-top:8mm">
    <div style="display:flex;align-items:baseline;gap:3mm;border-bottom:0.5mm solid #1F3D2B;padding-bottom:1.5mm">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;font-weight:500;color:#A98545">05</span>
      <h2 style="margin:0;font-size:9pt;font-weight:600;letter-spacing:.17em;text-transform:uppercase;color:#1F3D2B">Pièces à joindre</h2>
      <span style="margin-left:auto;font-size:6.3pt;color:#8A8477">À cocher par l'administration</span>
    </div>
    <div style="margin-top:4.5mm;display:grid;grid-template-columns:1fr 1fr;gap:3mm 8mm">
      <span style="display:flex;gap:3mm;align-items:flex-start;font-size:8.3pt;line-height:1.4"><span style="flex:none;width:4.2mm;height:4.2mm;border:0.4mm solid #4A453D;margin-top:0.4mm"></span>Certificat de scolarité</span>
      <span style="display:flex;gap:3mm;align-items:flex-start;font-size:8.3pt;line-height:1.4"><span style="flex:none;width:4.2mm;height:4.2mm;border:0.4mm solid #4A453D;margin-top:0.4mm"></span>Bulletins scolaires de l'année précédente</span>
      <span style="display:flex;gap:3mm;align-items:flex-start;font-size:8.3pt;line-height:1.4"><span style="flex:none;width:4.2mm;height:4.2mm;border:0.4mm solid #4A453D;margin-top:0.4mm"></span>Fiche infirmerie</span>
      <span style="display:flex;gap:3mm;align-items:flex-start;font-size:8.3pt;line-height:1.4"><span style="flex:none;width:4.2mm;height:4.2mm;border:0.4mm solid #4A453D;margin-top:0.4mm"></span>Photocopie de l'attestation d'assurance scolaire</span>
      <span style="display:flex;gap:3mm;align-items:flex-start;font-size:8.3pt;line-height:1.4"><span style="flex:none;width:4.2mm;height:4.2mm;border:0.4mm solid #4A453D;margin-top:0.4mm"></span>Photocopie de la pièce d'identité d'un parent</span>
    </div>
  </div>

  <div style="margin-top:8mm">
    <div style="display:flex;align-items:baseline;gap:3mm;border-bottom:0.5mm solid #1F3D2B;padding-bottom:1.5mm">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;font-weight:500;color:#A98545">06</span>
      <h2 style="margin:0;font-size:9pt;font-weight:600;letter-spacing:.17em;text-transform:uppercase;color:#1F3D2B">Frais de scolarité et volume horaire</h2>
    </div>
    <table style="margin-top:4mm;width:100%;border-collapse:collapse;font-size:8.5pt">
      <tbody>
        <tr>
          <td style="border-bottom:0.2mm solid #E0DBD0;padding:2.3mm 0;color:#3A362F">Frais de la formation <span style="color:#8A8477">(prix en TTC)</span></td>
          <td style="border-bottom:0.2mm solid #E0DBD0;padding:2.3mm 0;text-align:right;font-family:'IBM Plex Mono',monospace;color:#1C1A17">{{tarif_formation}}</td>
        </tr>
        <tr>
          <td style="border-bottom:0.2mm solid #E0DBD0;padding:2.3mm 0;color:#3A362F">Frais administratifs</td>
          <td style="border-bottom:0.2mm solid #E0DBD0;padding:2.3mm 0;text-align:right;font-family:'IBM Plex Mono',monospace;color:#1C1A17">{{frais_dossier}}</td>
        </tr>
        <tr>
          <td style="border-bottom:0.6mm solid #1F3D2B;padding:2.8mm 0;font-weight:700;letter-spacing:.03em;color:#1F3D2B">Total à verser</td>
          <td style="border-bottom:0.6mm solid #1F3D2B;padding:2.8mm 0;text-align:right;font-family:'IBM Plex Mono',monospace;font-size:9.5pt;color:#1C1A17">{{total}}</td>
        </tr>
        <tr>
          <td style="border-bottom:0.2mm solid #E0DBD0;padding:2.3mm 0;color:#3A362F">Nombre d'heures</td>
          <td style="border-bottom:0.2mm solid #E0DBD0;padding:2.3mm 0;text-align:right;font-family:'IBM Plex Mono',monospace;color:#1C1A17">{{volume_horaire}}</td>
        </tr>
        <tr>
          <td style="padding:2.3mm 0;color:#3A362F">Période de formation</td>
          <td style="padding:2.3mm 0;text-align:right;color:#3A362F">voir calendrier annuel</td>
        </tr>
      </tbody>
    </table>
    <div style="margin-top:3.5mm;display:grid;grid-template-columns:1fr 1fr;gap:5mm">
      <label style="display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Montant réglé</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{montant}}</span>
      </label>
      <label style="display:flex;flex-direction:column;gap:1mm">
        <span style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Mode de paiement</span>
        <span style="border-bottom:0.3mm solid #B5AF9F;height:6.5mm;font-family:'IBM Plex Mono',monospace;font-size:8pt;line-height:6.5mm;color:#1C1A17">{{mode_paiement}}</span>
      </label>
    </div>
  </div>

  <div style="margin-top:8mm">
    <div style="display:flex;align-items:baseline;gap:3mm;border-bottom:0.5mm solid #1F3D2B;padding-bottom:1.5mm">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;font-weight:500;color:#A98545">07</span>
      <h2 style="margin:0;font-size:9pt;font-weight:600;letter-spacing:.17em;text-transform:uppercase;color:#1F3D2B">Engagement du responsable légal</h2>
    </div>
    <div style="margin-top:4.5mm;border:0.3mm solid #C9C3B6;border-left:0.9mm solid #1F3D2B;background:#FAF8F3;padding:4mm 5mm">
      <p style="margin:0;font-size:8.8pt;line-height:1.7;text-wrap:pretty">Je soussigné(e) <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;color:#1C1A17;border-bottom:0.3mm solid #B5AF9F;padding:0 8mm 0 1mm">{{rl_nom_prenom}}</span> responsable légal de l'enfant <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;color:#1C1A17;border-bottom:0.3mm solid #B5AF9F;padding:0 8mm 0 1mm">{{nom_prenom}}</span> sollicite son admission aux formations choisies.</p>
      <p style="margin:2.5mm 0 0;font-size:8.8pt;line-height:1.65;color:#3A362F">Je m'engage à verser les frais de formation. Je m'engage à respecter le contrat de formation.</p>
      <div style="margin-top:4mm;display:flex;flex-direction:column;gap:2.5mm">
        <span style="display:flex;gap:3mm;align-items:flex-start;font-size:8.3pt;line-height:1.55;color:#3A362F"><span style="flex:none;width:4.5mm;height:4.5mm;border:0.4mm solid #4A453D;margin-top:0.3mm"></span>J'autorise mon enfant à quitter seul l'établissement après son cours</span>
        <span style="display:flex;gap:3mm;align-items:flex-start;font-size:8.3pt;line-height:1.55;color:#3A362F"><span style="flex:none;width:4.5mm;height:4.5mm;border:0.4mm solid #4A453D;margin-top:0.3mm"></span>J'accepte que mon enfant soit filmé et/ou photographié lors des activités organisées au sein de l'association</span>
      </div>
    </div>
    <div style="margin-top:6mm;display:flex;justify-content:space-between;align-items:flex-end;gap:10mm">
      <div style="flex:1;max-width:72mm">
        <div style="font-size:8.8pt">Fait à {{organisation.ville}}, le <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;color:#1C1A17">{{date}}</span></div>
        <div style="margin-top:2mm;border-bottom:0.3mm solid #B5AF9F;height:3mm"></div>
      </div>
      <div style="flex:1;max-width:72mm">
        <div style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Signature</div>
        <div style="margin-top:2mm;border-bottom:0.3mm solid #B5AF9F;height:14mm"></div>
      </div>
    </div>
  </div>

  <div style="margin-top:auto;padding-top:6mm;display:flex;justify-content:space-between;align-items:flex-end;gap:6mm;border-top:0.2mm solid #D5CFC2;font-size:5.8pt;color:#8A8477;line-height:1.6">
    <div style="font-family:'IBM Plex Mono',monospace">{{organisation.nom}} · {{organisation.adresseComplete}} · Tél. {{organisation.telephone}} · SIRET {{organisation.siret}} · NAF {{organisation.naf}}</div>
    <div style="flex:none;letter-spacing:.1em;text-transform:uppercase">Page 2 / 4</div>
  </div>
</div>

<div class="page" style="padding:12mm 15mm 10mm;background:#fff;font-family:Archivo,Helvetica,Arial,sans-serif;color:#1C1A17;display:flex;flex-direction:column">

  <div style="display:flex;align-items:baseline;justify-content:space-between;border-bottom:0.8mm solid #1F3D2B;padding-bottom:2.5mm">
    <div style="font-family:Spectral,Georgia,serif;font-size:10.5pt;font-weight:600;color:#1F3D2B">Dossier d'inscription — {{section_nom}}</div>
    <div style="font-size:6.8pt;letter-spacing:.14em;text-transform:uppercase;color:#7A7568">{{annee_scolaire}}</div>
  </div>

  <div style="margin-top:6.5mm;display:flex;align-items:baseline;gap:3mm">
    <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;font-weight:500;color:#A98545">08</span>
    <h2 style="margin:0;font-family:Spectral,Georgia,serif;font-size:16pt;font-weight:600;color:#1F3D2B">Règlement intérieur — section Jeunes</h2>
  </div>

  <div style="margin-top:5.5mm;column-count:2;column-gap:9mm;column-rule:0.2mm solid #E0DBD0;font-size:7.5pt;line-height:1.5;color:#25221E;text-align:justify;hyphens:auto">
    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 1 — Horaires</h3>
    <p style="margin:0 0 3.5mm">{{organisation.nom}} ouvre ses portes : de 13h15 à 13h30 et de 16h30 à 16h45 pour accueillir les élèves inscrits à la formation jeunes</p>

    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 2 — Sorties</h3>
    <p style="margin:0 0 3.5mm">En dehors des horaires ci-dessus, aucun élève ne sera autorisé à sortir, sauf motif grave. Dans ce cas, les parents ou le responsable de l'enfant ayant prévenu préalablement, devront venir chercher leur enfant. S'il s'avère que l'enfant rentre seul ou avec une tierce personne, une autorisation écrite doit être remise en mains propres par les parents à l'administration, indiquant les noms des personnes concernés. Celles-ci devront présenter leurs pièces d'identité lors de la sortie de l'enfant.</p>

    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 3 — Retards</h3>
    <p style="margin:0 0 3.5mm">Tout élève en retard doit, dès son arrivée, signaler son retard à l'administration, et ne pourra accéder à la salle de cours qu'après avoir reçu un billet d'entrée. Si les retards se répètent une sanction sera envisagée.</p>

    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 4 — Fréquentation</h3>
    <p style="margin:0 0 2mm">Les seules absences autorisées sont la maladie de l'élève, une maladie contagieuse dans la famille ou une cérémonie familiale à caractère exceptionnelle. Ces absences doivent être justifiées auprès de l'administration ou par le biais du carnet de correspondance.</p>
    <p style="margin:0 0 3.5mm">Les absences non justifiées sont comptabilisées et consignées dans un dossier. Elles sont signalées aux responsables de l'enfant, et si elles sont répétées plus de deux fois, une sanction allant jusqu'à l'exclusion est applicable.</p>

    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 5 — Comportement</h3>
    <p style="margin:0 0 2mm">Les élèves sont confiés par la famille au maître de la classe ou à l'administration. En cas de problème ou de demande d'informations, c'est à eux qu'il faudra s'adresser.</p>
    <p style="margin:0 0 2mm">{{organisation.nom}} est basée sur le respect mutuel entre tous les membres de la communauté éducative (parents, élèves, enseignants…).</p>
    <p style="margin:0 0 2mm">La violence, tant en acte comme parole, est strictement interdite. Tout manquement grave de la part d'un élève entrainera sont exclusion temporaire ou définitive de la classe.</p>
    <p style="margin:0 0 2mm">Les élèves n'apporteront que les objets nécessaires aux activités ou expressément demandés par l'enseignant. Aucune réclamation ne pourra être faite pour d'autres objets s'ils sont perdus ou détériorés. Sont notamment interdits :</p>
    <ul style="margin:0 0 2mm;padding-left:4mm">
      <li style="margin-bottom:1mm">Les médicaments (sauf accord préalable pour certaines maladies)</li>
      <li style="margin-bottom:1mm">Les objets dangereux (couteaux, cutters, ciseaux à bouts pointus, allumettes, lampes laser, pétards, …)</li>
      <li style="margin-bottom:1mm">Les jouets électroniques ou imitant les armes</li>
      <li style="margin-bottom:1mm">L'argent (sauf celui demandé par l'enseignant) et tout objet de valeur</li>
    </ul>
    <p style="margin:0">En cas d'accident ou de malaise, l'élève devra immédiatement prévenir l'enseignant (au besoin, un camarade le fera pour lui). Toute déclaration faite après la sortie ne pourra être prise en considération.</p>
  </div>

  <div style="margin-top:auto;padding-top:6mm;display:flex;justify-content:space-between;align-items:flex-end;gap:6mm;border-top:0.2mm solid #D5CFC2;font-size:5.8pt;color:#8A8477;line-height:1.6">
    <div style="font-family:'IBM Plex Mono',monospace">{{organisation.nom}} · {{organisation.adresseComplete}} · Tél. {{organisation.telephone}} · SIRET {{organisation.siret}} · NAF {{organisation.naf}}</div>
    <div style="flex:none;letter-spacing:.1em;text-transform:uppercase">Page 3 / 4</div>
  </div>
</div>

<div class="page" style="padding:12mm 15mm 10mm;background:#fff;font-family:Archivo,Helvetica,Arial,sans-serif;color:#1C1A17;display:flex;flex-direction:column">

  <div style="display:flex;align-items:baseline;justify-content:space-between;border-bottom:0.8mm solid #1F3D2B;padding-bottom:2.5mm">
    <div style="font-family:Spectral,Georgia,serif;font-size:10.5pt;font-weight:600;color:#1F3D2B">Dossier d'inscription — {{section_nom}}</div>
    <div style="font-size:6.8pt;letter-spacing:.14em;text-transform:uppercase;color:#7A7568">{{annee_scolaire}}</div>
  </div>

  <div style="margin-top:6mm;font-size:6.8pt;letter-spacing:.14em;text-transform:uppercase;color:#7A7568">Règlement intérieur — section Jeunes (suite)</div>

  <div style="margin-top:4mm;column-count:2;column-gap:9mm;column-rule:0.2mm solid #E0DBD0;font-size:7.5pt;line-height:1.5;color:#25221E;text-align:justify;hyphens:auto">
    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 6 — Récréation</h3>
    <p style="margin:0 0 2mm">Tout comportement violant ou insultant est strictement interdit et les élèves ne respectant pas cette règle seront sanctionnés. Ils pourront être partiellement privés de récréation et cela, selon les cas, peut aller jusqu'à l'exclusion.</p>
    <p style="margin:0 0 2mm">Les élèves, à la sonnerie ou au signal de l'enseignant, cesseront immédiatement leurs jeux et retourneront en classe.</p>
    <p style="margin:0 0 2mm">La circulation dans les couloirs est interdite pendant ces moments.</p>
    <p style="margin:0 0 3.5mm">Les balles dures, petites ou grosses sont interdites, ainsi que les billes</p>

    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 7 — Tenue vestimentaire</h3>
    <p style="margin:0 0 3.5mm">Les règles morales de l'établissement doivent être observées en matière de tenue vestimentaire. Une apparence descente et respectueuse doit être observée pour l'ensemble des élèves et du corps enseignant.</p>

    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 8 — Suivi du travail</h3>
    <p style="margin:0 0 2mm">Les cahiers de classe sont régulièrement remis aux parents et doivent être rapportés signés dès le cours suivant.</p>
    <p style="margin:0 0 2mm">Un livret d'évaluation est remis aux parents en mains propres.</p>
    <p style="margin:0 0 2mm">Des réunions d'informations sont prévues en début d'année et, si nécessaire, en cours d'année.</p>
    <p style="margin:0 0 2mm">Personne n'est autorisé à pénétrer dans les salles de cours ou à discuter avec les enseignants afin de ne pas gêner les débuts des cours.</p>
    <p style="margin:0 0 2mm">Les parents peuvent rencontrer le directeur ou l'enseignant de leur enfant sur rendez-vous ; la demande doit être faite sur le cahier de correspondance. Ce cahier doit être consulté régulièrement par les parents.</p>
    <p style="margin:0 0 3.5mm">Ceux-ci doivent aussi impérativement veiller à l'accomplissement du travail demandé. Le cas échéant, des sanctions allant jusqu'à l'exclusion pourraient être prises.</p>

    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 9 — Sanctions</h3>
    <p style="margin:0 0 2mm">Une sanction sera envisagée pour un exercice non fait, un devoir incomplet, une leçon non sue, un manquement concernant le comportement, une absence injustifiée, un bavardage, la non-présentation d'une signature (devoir, relevé de notes …) / oubli de matériel …</p>
    <div style="margin:0 0 3.5mm;padding:2.5mm 3mm;background:#FAF8F3;border-left:0.6mm solid #A98545;font-size:7pt;font-weight:600;letter-spacing:.04em;line-height:1.5;text-align:left;color:#1F3D2B">QUATRE AVERTISSEMENTS DE CONDUITE = LA CONVOCATION DES PARENTS<br />DEUX CONVOCATIONS = UNE EXCLUSION TEMPORAIRE OU DEFINITIVE</div>

    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 10 — Sécurité</h3>
    <p style="margin:0 0 3.5mm">L'assurance contre les accidents subis ou causés est obligatoire. Les parents veilleront à en fournir, en début d'année, le justificatif. Il est interdit de stationner devant l'école notamment aux heures de sorties des enfants.</p>

    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#1F3D2B;break-after:avoid">Article 11 — Annulation d'inscription et remboursement</h3>
    <p style="margin:0 0 2mm">Pour demander l'annulation de son inscription, l'étudiant devra envoyer une lettre recommandée avec accusé de réception au directeur de {{organisation.nom}} (le cachet de la poste faisant foi). Deux cas se présentent :</p>
    <ul style="margin:0 0 2mm;padding-left:4mm">
      <li style="margin-bottom:1.5mm">si la demande d'annulation intervient avant le début des cours, autrement dit avant la date officielle annoncée, {{organisation.nom}} s'engage à lui rembourser la totalité des frais d'études engagés (les frais administratifs ne sont pas remboursables)</li>
      <li style="margin-bottom:1.5mm">si la demande d'annulation intervient après le début des cours, l'étudiant sera tenu de payer des frais d'annulation. Le remboursement est calculé à partir de la date effective d'annulation (date d'envoi de la lettre recommandée) :</li>
    </ul>
    <div style="margin:0 0 2mm 4mm;padding-left:3mm;border-left:0.3mm solid #A98545">
      <p style="margin:0 0 1.5mm">Entre le 1<sup>ier</sup> et avant le 15<sup>ième</sup> jour après le début des cours, le remboursement est de {{remboursement_avant_15_jours}} % des frais d'études</p>
      <p style="margin:0">Entre le 15<sup>ième</sup> et avant le 29<sup>ième</sup> jour après le début des cours, le remboursement est de {{remboursement_avant_29_jours}} % des frais d'études</p>
    </div>
    <p style="margin:0 0 3.5mm">Après 29 jours depuis le début des cours, {{organisation.nom}} ne remboursera aucun frais engagés (et ce même si les chèques ne sont pas encore encaissés ; ils demeurent de droits la propriété de l'établissement). Il n'est donc consenti ni réduction ni remboursement en cas d'absences ou de départ en cours d'année. {{organisation.nom}} procèdera au remboursement dans un délai maximum de trois mois après la demande.</p>

    {{#if reglesSpecifiques.length}}
    <h3 style="margin:0 0 1.5mm;font-size:7.2pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#A98545;break-after:avoid">Dispositions propres à la section</h3>
    <ul style="margin:0;padding-left:4mm;font-style:italic;color:#5A554C">
      {{#each reglesSpecifiques}}<li style="margin-bottom:1mm">{{this}}</li>{{/each}}
    </ul>
    {{/if}}
  </div>

  <div style="margin-top:6mm;border:0.3mm solid #C9C3B6;padding:4.5mm 5mm">
    <p style="margin:0;font-size:8.3pt;line-height:1.75;text-wrap:pretty">Madame <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;color:#1C1A17;border-bottom:0.3mm solid #B5AF9F;padding:0 6mm 0 1mm">{{rl_mere}}</span> ou Monsieur <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;color:#1C1A17;border-bottom:0.3mm solid #B5AF9F;padding:0 6mm 0 1mm">{{rl_pere}}</span> responsable(s) légale de l'élève <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;color:#1C1A17;border-bottom:0.3mm solid #B5AF9F;padding:0 6mm 0 1mm">{{nom_prenom}}</span> (a) ont pris connaissance du règlement de l'établissement et s'engage(nt) à le respecter.</p>
    <div style="margin-top:5mm;display:flex;justify-content:space-between;align-items:flex-end;gap:10mm">
      <div style="flex:1;max-width:72mm">
        <div style="font-size:8.3pt">{{organisation.ville}}, le <span style="font-family:'IBM Plex Mono',monospace;font-size:8pt;color:#1C1A17">{{date}}</span></div>
        <div style="margin-top:2mm;border-bottom:0.3mm solid #B5AF9F;height:3mm"></div>
      </div>
      <div style="flex:1;max-width:72mm">
        <div style="font-size:6.3pt;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7A7568">Signature des responsables</div>
        <div style="margin-top:2mm;border-bottom:0.3mm solid #B5AF9F;height:12mm"></div>
      </div>
    </div>
  </div>

  <div style="margin-top:auto;padding-top:6mm;display:flex;justify-content:space-between;align-items:flex-end;gap:6mm;border-top:0.2mm solid #D5CFC2;font-size:5.8pt;color:#8A8477;line-height:1.6">
    <div style="font-family:'IBM Plex Mono',monospace">{{organisation.nom}} · {{organisation.adresseComplete}} · Tél. {{organisation.telephone}} · SIRET {{organisation.siret}} · NAF {{organisation.naf}}</div>
    <div style="flex:none;letter-spacing:.1em;text-transform:uppercase">Page 4 / 4</div>
  </div>
</div>

</body>
</html>
