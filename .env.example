# Copier en .env pour le développement local, ou fournir ces valeurs comme
# variables d'environnement/secrets sur le serveur de déploiement.
# Ne jamais committer le fichier .env réel.

# --- Base de données ---
POSTGRES_USER=oree
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=oree_du_savoir
# En local (hors Docker, ex. `npm run dev`) : connexion via localhost.
# En conteneur (docker-compose) : DATABASE_URL est recalculée vers le service "db".
DATABASE_URL="postgresql://oree:changeme_dev_password@localhost:5432/oree_du_savoir?schema=public"

# --- Sessions ---
# Chaîne aléatoire longue (ex: `openssl rand -hex 32`). Change = déconnecte tous les utilisateurs.
SESSION_SECRET=changeme_generate_a_long_random_secret

# --- Compte administrateur initial (créé par le script de seed, une seule fois) ---
ADMIN_EMAIL=admin@association.local
ADMIN_PASSWORD=changeme_first_login_password
ADMIN_NOM=Administrateur
ADMIN_PRENOM=Compte

# --- Fuseau horaire de l'application ---
# Détermine le « jour courant » (séances du jour, délai de correction des
# présences). Doit correspondre au fuseau réel de l'association.
TZ=Europe/Paris

# --- Stockage fichiers (documents/justificatifs), séparé de la base ---
# Chemin à l'intérieur du conteneur ; à monter sur un volume/point NAS persistant.
DOCUMENTS_DIR=/data/documents

# --- QR d'accès à la séance (optionnel) ---
# Par défaut, l'URL encodée dans le QR (page Classe → "QR d'accès à la
# séance du jour") reprend l'hôte de la requête qui affiche la page. Si le
# staff ouvre l'application via "localhost" ou un tunnel/nom interne (ex.
# connecté en SSH sur le serveur) plutôt que par l'IP réelle de la machine,
# le QR pointe vers un hôte injoignable depuis le téléphone qui le scanne en
# salle : renseigner ici l'IP (ou le nom) réellement accessible depuis le
# réseau de l'association, port inclus si différent de 80/443
# (ex. 192.168.1.50:3000). Laisser vide pour garder la détection automatique.
PUBLIC_HOST=

# --- Cloisonnement du hostname public de la préinscription (Cloudflare Tunnel) ---
# Nom d'hôte exact (sans schéma ni port, ex. preinscription.loreedusavoir.fr)
# par lequel Internet atteint l'application via le tunnel sortant (voir
# ARCHITECTURE-PREINSCRIPTION.md). Quand une requête arrive avec ce hostname
# (en-tête Host), src/proxy.ts n'autorise plus que /preinscription et les
# ressources Next.js nécessaires (_next/static, favicon) — tout le reste
# (y compris /login, /admin, /etudiants, /api/internal/n8n/*) répond 404,
# indépendamment de l'authentification applicative. Laisser vide désactive
# ce contrôle sans aucun effet sur l'accès LAN habituel — à ne renseigner
# qu'une fois le tunnel effectivement en place.
PREINSCRIPTION_PUBLIC_HOSTNAME=

# --- Authentification interne n8n (routes /api/internal/n8n/*) ---
# Bearer token statique partagé entre l'app et n8n, pour ce déploiement
# uniquement (ex: `openssl rand -hex 32`). Laisser vide désactive ces routes
# (refus systématique) sans affecter le reste de l'app, qui fonctionne
# normalement sans n8n. Ne jamais logger ni committer la valeur réelle.
N8N_INTERNAL_API_SECRET=

# --- Limite de taille des fichiers uploadés (préinscription publique + Server Actions) ---
# Voir src/lib/fichiers-uploades.ts. S'applique aussi au plafond global des
# Server Actions (next.config.ts) : Next.js le limite par défaut à 1 Mo, ce
# qui n'est pas pensé comme une protection volontaire.
TAILLE_MAX_FICHIER_MO=8

# --- Génération PDF des dossiers d'inscription (Puppeteer) ---
# Chemin vers un exécutable Chromium/Chrome. En conteneur (docker-compose),
# le Dockerfile installe le paquet système "chromium" et fixe cette valeur
# automatiquement (/usr/bin/chromium) — ne rien mettre ici pour prod. En
# local (`npm run dev`), renseigner le Chrome/Chromium déjà installé sur le
# poste, ou en récupérer un dédié via
# `npx @puppeteer/browsers install chromium@latest --path ./.cache-chromium`.
PUPPETEER_EXECUTABLE_PATH=

# --- Documenso (self-hébergé, signature électronique des dossiers) ---
# Voir docker-compose.yml (services documenso/documenso-db/documenso-minio/
# documenso-mail) et src/lib/documenso.ts. Ce bloc démarre une instance
# Documenso complète, isolée de la base applicative (aucune raison de la
# mélanger avec les données métier, même principe que n8n).
#
# NOTE IMPORTANTE : Documenso génère des URL d'upload/téléchargement
# présignées à partir de NEXT_PRIVATE_UPLOAD_ENDPOINT (donc vers
# "documenso-minio", nom de service Docker) — ces URL sont utilisées
# directement par l'application (src/lib/documenso.ts), qui doit donc
# tourner SUR LE MÊME RÉSEAU DOCKER pour les résoudre. En pratique : lancer
# l'app via `docker compose up -d app` (jamais `npm run dev` sur l'hôte) dès
# que Documenso est dans la boucle.
DOCUMENSO_POSTGRES_USER=documenso
DOCUMENSO_POSTGRES_PASSWORD=changeme_documenso_db_password
DOCUMENSO_POSTGRES_DB=documenso
# Générer avec `openssl rand -hex 32` (les deux distincts l'un de l'autre).
DOCUMENSO_NEXTAUTH_SECRET=changeme_generate_a_long_random_secret
DOCUMENSO_ENCRYPTION_KEY=changeme_generate_a_long_random_secret
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=changeme_generate_a_long_random_secret
# Passphrase du certificat de signature ./documenso-cert/cert.p12 (à générer
# une fois, voir DEPLOIEMENT.md) — doit correspondre exactement au mot de
# passe utilisé lors de la génération du .p12.
DOCUMENSO_SIGNING_PASSPHRASE=changeme_documenso_cert
DOCUMENSO_MINIO_ROOT_USER=documenso
DOCUMENSO_MINIO_ROOT_PASSWORD=changeme_documenso_minio_password
# URL par laquelle Documenso lui-même est joignable (utilisée dans ses liens
# internes) — http://localhost:3100 en dev, l'URL réelle du service en prod.
DOCUMENSO_WEBAPP_URL=http://localhost:3100
# Secret partagé pour authentifier les webhooks Documenso → application (voir
# src/app/api/webhooks/documenso/route.ts, en-tête X-Documenso-Secret) —
# généré avec `openssl rand -hex 32`, à recopier tel quel lors de la
# création du webhook dans l'interface Documenso.
DOCUMENSO_WEBHOOK_SECRET=
# Token API généré manuellement, une fois Documenso démarré, depuis
# Documenso > Paramètres de l'équipe > Tokens API — jamais exposé au
# navigateur (voir src/lib/documenso.ts, "server-only").
DOCUMENSO_API_TOKEN=
DOCUMENSO_API_URL=http://localhost:3100/api/v1
# Sous-réseau Docker Compose (passerelle) + nom du service applicatif :
# autorise le webhook Documenso à cibler l'app malgré la protection SSRF par
# défaut contre les adresses privées. À ajuster si le sous-réseau change
# (voir `docker network inspect` sur le réseau compose).
DOCUMENSO_WEBHOOK_SSRF_BYPASS_HOSTS=172.19.0.1,app

# --- Cloudflare Tunnel (connecteur cloudflared, tunnel "oree-preinscription" existant) ---
# Token de connecteur généré depuis Cloudflare Zero Trust > Networks > Tunnels
# > oree-preinscription > "Install connector" (voir
# CONFIGURATION-CLOUDFLARE-PREINSCRIPTION.md §4-5). Secret critique : jamais
# committé, jamais logué, jamais dans ce fichier réel — uniquement dans
# l'environnement du serveur de production qui exécute le service
# cloudflared (docker-compose.yml).
CLOUDFLARE_TUNNEL_TOKEN=
