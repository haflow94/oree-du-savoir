# Copier en .env pour le développement local, ou fournir ces valeurs comme
# variables d'environnement/secrets sur le serveur de déploiement.
# Ne jamais committer le fichier .env réel.

# --- Base de données ---
POSTGRES_USER=oree
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=oree_du_savoir
# En local (hors Docker, ex. `npm run dev`) : connexion via localhost.
# En conteneur (docker-compose) : DATABASE_URL est recalculée vers le service "db".
DATABASE_URL="postgresql://oree:changeme_dev_password@localhost:5432/oree_du_savoir?schema=public"

# --- Sessions ---
# Chaîne aléatoire longue (ex: `openssl rand -hex 32`). Change = déconnecte tous les utilisateurs.
SESSION_SECRET=changeme_generate_a_long_random_secret

# --- Compte administrateur initial (créé par le script de seed, une seule fois) ---
ADMIN_EMAIL=admin@association.local
ADMIN_PASSWORD=changeme_first_login_password
ADMIN_NOM=Administrateur
ADMIN_PRENOM=Compte

# --- Fuseau horaire de l'application ---
# Détermine le « jour courant » (séances du jour, délai de correction des
# présences). Doit correspondre au fuseau réel de l'association.
TZ=Europe/Paris

# --- Stockage fichiers (documents/justificatifs), séparé de la base ---
# Chemin à l'intérieur du conteneur ; à monter sur un volume/point NAS persistant.
DOCUMENTS_DIR=/data/documents

# --- QR d'accès à la séance (optionnel) ---
# Par défaut, l'URL encodée dans le QR (page Classe → "QR d'accès à la
# séance du jour") reprend l'hôte de la requête qui affiche la page. Si le
# staff ouvre l'application via "localhost" ou un tunnel/nom interne (ex.
# connecté en SSH sur le serveur) plutôt que par l'IP réelle de la machine,
# le QR pointe vers un hôte injoignable depuis le téléphone qui le scanne en
# salle : renseigner ici l'IP (ou le nom) réellement accessible depuis le
# réseau de l'association, port inclus si différent de 80/443
# (ex. 192.168.1.50:3000). Laisser vide pour garder la détection automatique.
PUBLIC_HOST=

# --- Génération PDF des dossiers d'inscription (Puppeteer) ---
# Chemin vers un exécutable Chromium/Chrome. En conteneur (docker-compose),
# le Dockerfile installe le paquet système "chromium" et fixe cette valeur
# automatiquement (/usr/bin/chromium) — ne rien mettre ici pour prod. En
# local (`npm run dev`), renseigner le Chrome/Chromium déjà installé sur le
# poste, ou en récupérer un dédié via
# `npx @puppeteer/browsers install chromium@latest --path ./.cache-chromium`.
PUPPETEER_EXECUTABLE_PATH=
