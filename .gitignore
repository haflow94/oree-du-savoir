# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# fichiers applicatifs (documents/justificatifs) en dev local — jamais en base, jamais versionnés
/data
/backups

# Filet de sécurité en plus de /backups ci-dessus : exports/dumps manuels de
# production (pg_dump, tar de volumes) parfois posés par erreur à la racine
# du dépôt au lieu de /backups — jamais versionnés, quel que soit l'endroit
# où ils atterrissent (audit du 2026-09-08, voir oree-*.dump trouvés à la
# racine).
*.dump
*.dump.gz
oree-*.tar.gz

# Chromium local pour tester la génération PDF en dev (npm run dev) — en
# production le Dockerfile installe le paquet système "chromium" à la place
# (voir src/lib/dossier/browser.ts et PUPPETEER_EXECUTABLE_PATH).
/.cache-chromium

# Certificat de signature Documenso (clé privée protégée par
# DOCUMENSO_SIGNING_PASSPHRASE) — jamais versionné, à régénérer sur chaque
# environnement (voir DEPLOIEMENT.md).
/documenso-cert
