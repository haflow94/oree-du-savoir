[Unit]
Description=Déclenche la vérification infra (conteneurs, tunnel public, disque) toutes les 2 minutes (cadence resserrée pour la période d'inscription 2026-09-16 -> 2026-09-30, à desserrer ensuite si besoin)

[Timer]
OnBootSec=1min
OnUnitActiveSec=2min
Unit=oree-surveille-infra.service

[Install]
WantedBy=timers.target
