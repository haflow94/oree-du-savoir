// Phase 0 : fondations (auth, rôles, années scolaires).
// Phase 1 : fiche étudiant + responsables légaux, cours + classes.
// Les entités suivantes (Inscription, Paiement, etc.) seront ajoutées
// phase par phase, une fois les décisions en attente validées (voir plan).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUREAU
  ADMINISTRATION
  ACCUEIL
  TRESORIER
  ENSEIGNANT
}

model Utilisateur {
  id             String    @id @default(cuid())
  email          String    @unique
  motDePasseHash String
  nom            String
  prenom         String
  role           Role
  actif          Boolean   @default(true)
  creeLe         DateTime  @default(now())
  dernierLogin   DateTime?

  sessions          Session[]
  journalAudit      JournalAudit[]
  classesEnseignees ClasseEnseignant[]

  @@map("utilisateurs")
}

// Sessions stockées en base (pas de JWT) : révocation immédiate possible
// (désactivation d'un utilisateur = invalidation de toutes ses sessions).
model Session {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  creeLe        DateTime @default(now())
  expireLe      DateTime

  @@index([utilisateurId])
  @@map("sessions")
}

model AnneeScolaire {
  id        String   @id @default(cuid())
  libelle   String   @unique // ex. "2026/2027"
  dateDebut DateTime
  dateFin   DateTime
  active    Boolean  @default(false)

  classes Classe[]

  @@map("annees_scolaires")
}

enum Civilite {
  M
  MME
}

// Fiche unique par personne (voir 02_Modele_metier.md, règle 1). L'historique
// des inscriptions/cours par année arrive avec les modèles Cours/Classe
// (phase suivante) ; cette table ne porte que l'identité et les coordonnées.
//
// Le champ `DDF` présent dans l'ancienne BDD Excel n'est pas repris : sa
// signification doit être confirmée avec l'association avant intégration
// (voir Projet/03_Analyse_existant_Excel.md, section 3.3). Ne pas deviner.
model Etudiant {
  id                String    @id @default(cuid())
  civilite          Civilite?
  nom               String
  prenom            String
  dateNaissance     DateTime?
  villeNaissance    String?
  telephoneMobile   String?
  telephoneFixe     String?
  email             String?
  adresse           String?
  complementAdresse String?
  profession        String?
  niveauEtudes      String?
  dernierDiplome    String?
  remarque          String?
  creeLe            DateTime  @default(now())
  misAJourLe        DateTime  @updatedAt

  responsables ResponsableLegal[]

  @@index([nom, prenom])
  @@map("etudiants")
}

// Parent/tuteur. Rattaché directement à l'étudiant : le partage d'un même
// responsable entre plusieurs étudiants (fratrie) n'est pas géré en Phase 1,
// faute de besoin confirmé — à revisiter si nécessaire.
model ResponsableLegal {
  id         String    @id @default(cuid())
  etudiantId String
  etudiant   Etudiant  @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  civilite   Civilite?
  nom        String
  prenom     String
  lien       String // ex. "Père", "Mère", "Tuteur"
  telephone  String?
  email      String?
  adresse    String?
  creeLe     DateTime  @default(now())

  @@index([etudiantId])
  @@map("responsables_legaux")
}

// Un cours peut être enseigné par plusieurs classes/groupes (ex. plusieurs
// créneaux/niveaux du même cours). Ne pas confondre avec Classe : le cours
// est la matière, la classe est le groupe concret relié au planning.
model Cours {
  id          String  @id @default(cuid())
  nom         String  @unique
  description String?
  creeLe      DateTime @default(now())

  classes Classe[]

  @@map("cours")
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

// Groupe concret relié au planning (voir 03_Analyse_existant_Excel.md §3.5 :
// ne jamais stocker la classe comme simple texte sur l'étudiant).
//
// Décisions MVP validées avec l'association :
// - niveau = attribut texte simple sur la classe (pas de référentiel séparé) ;
// - un seul créneau hebdomadaire par classe (jour + heure début/fin) ;
// - plusieurs enseignants possibles par classe (table de liaison).
model Classe {
  id              String   @id @default(cuid())
  coursId         String
  cours           Cours    @relation(fields: [coursId], references: [id], onDelete: Restrict)
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Restrict)
  niveau          String?
  semestre        String? // ex. "1", "2" ; null = classe valable toute l'année
  jour            JourSemaine
  heureDebut      String // "HH:MM"
  heureFin        String // "HH:MM"
  salle           String?
  capacite        Int?
  creeLe          DateTime @default(now())

  enseignants ClasseEnseignant[]

  @@index([anneeScolaireId])
  @@index([coursId])
  @@map("classes")
}

model ClasseEnseignant {
  classeId      String
  classe        Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@id([classeId, utilisateurId])
  @@map("classe_enseignants")
}

// Traçabilité transverse (validation dossier, modification présence validée,
// saisie paiement, etc.) — alimentée au fil des phases suivantes.
model JournalAudit {
  id            String       @id @default(cuid())
  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  action        String
  entite        String
  entiteId      String?
  details       Json?
  horodatage    DateTime     @default(now())

  @@index([utilisateurId])
  @@index([entite, entiteId])
  @@map("journal_audit")
}
