// Phase 0 : fondations (auth, rôles, années scolaires).
// Phase 1 : fiche étudiant + responsables légaux, cours + classes.
// Sections (Jeunes, Études Islamiques, Langue Arabe, Études Coraniques) :
// référentiel de tarification et barème de remboursement par section,
// repris des dossiers d'inscription papier. Le cours est rattaché à une
// section ; le montant dû du dossier annuel reste saisi manuellement pour
// le MVP (un dossier peut combiner plusieurs sections/cours).
// Phase 4/5 : dossier annuel minimal (montant dû saisi manuellement),
// paiements/échéances/chèques, trésorerie.
// Phase 3 : participation étudiant↔classe, périodes de fermeture, séances
// générées depuis le planning, présences.
// Phase 2 : préinscription publique (Etudiant.statutInscription : PREINSCRIT
// jusqu'au contrôle sur place, puis VALIDE), documents (métadonnées en base,
// fichiers sous DOCUMENTS_DIR), génération du dossier officiel en PDF.
// Réinscription multi-années : réutilise DossierAnnuel (une ligne par
// étudiant × année, déjà unique) sans modèle dédié.
// Phase 7 : Organisation (identité de l'association, sortie du code en dur)
// et modèles maîtres de dossier d'inscription (2 gabarits HTML/PDF —
// ADULTES/JEUNES — pilotés par Organisation + Section + CreneauSection +
// Etudiant, remplaçant les 4 gabarits .docx historiques par section).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUREAU
  ADMINISTRATION
  ACCUEIL
  TRESORIER
  ENSEIGNANT
  // Compte dédié à la gestion des activités associatives (voir
  // (app)/activites, (app)/calendrier et Administration → Responsables
  // d'activités), sans les droits Bureau/Administration sur le reste de
  // l'appli. Comme ENSEIGNANT, séparé des ROLES_STAFF (lib/roles.ts) : sa
  // propre page de comptes plutôt que mélangé à Administration → Comptes.
  ACTIVITE
}

// Modules métier couverts par la grille de permissions (Administration →
// Permissions, Bureau uniquement — voir lib/permissions.ts). Liste fixe :
// chaque module correspond à du code réel, pas de module créable depuis
// l'UI. N'inclut ni Recherche ni Tableau de bord (agrégateurs multi-modules,
// filtrés inline module par module) ni les écrans réservés au Bureau par
// nature (comptes/rôles, journal d'audit — voir requireRole littéral).
enum Module {
  ETUDIANTS
  CLASSES
  PRESENCES
  ACTIVITES
  PAIEMENTS
  TRESORERIE
  ADMINISTRATION
  DOCUMENTS
  INSCRIPTIONS
  CALENDRIER
  GOUVERNANCE
}

enum NiveauAcces {
  AUCUN
  LECTURE
  ECRITURE
}

// Grille rôle × module éditable depuis Administration → Permissions. BUREAU
// n'a délibérément pas besoin d'une ligne consultée à l'exécution : le
// helper (lib/permissions.ts) court-circuite ce rôle en ECRITURE avant toute
// lecture de cette table, pour éliminer tout risque de lock-out si le Bureau
// modifie sa propre ligne par erreur. Une ligne BUREAU est seedée quand même
// (affichage grisé de la grille), mais jamais lue par le helper.
model PermissionRole {
  id     String      @id @default(cuid())
  role   Role
  module Module
  niveau NiveauAcces @default(AUCUN)

  @@unique([role, module])
  @@map("permissions_role")
}

// Identité de l'association, jusqu'ici éparpillée en constantes codées en
// dur (ex. NOM_ASSOCIATION dans lib/pdf-documents.tsx, logo statique sous
// public/) : nom, coordonnées et logo utilisés par les dossiers
// d'inscription générés (voir src/lib/dossier/) et, à terme, par les autres
// documents émis par l'application. Une seule ligne existe aujourd'hui
// (l'association) — lue via `findFirst()` (voir src/lib/organisation.ts) —
// et aucune autre table ne porte de organisationId : l'app reste mono-
// organisation pour l'instant, cette table ne fait que sortir l'identité du
// code en dur, sans introduire de vrai multi-tenant (voir CLAUDE.md /
// analyse de conversation pour le détail des tables qui devraient recevoir
// un organisationId le jour où une deuxième organisation est nécessaire).
model Organisation {
  id                String        @id @default(cuid())
  nom               String
  // Sous-titre affiché sous le nom sur la page 1 du dossier (ex. "Institut
  // des cultures et des savoirs · Créteil") — jamais en dur dans le
  // template.
  sousTitre         String?
  adresse           String?
  codePostal        String?
  ville             String?
  telephone         String?
  email             String?
  siret             String?
  naf               String?
  // Fichier stocké comme les autres documents (jamais en base — voir
  // lib/documents.ts) ; remplacer le fichier suffit à changer de logo, sans
  // toucher aux templates (voir SPEC-dossiers.md §2 "Logo — interchangeable").
  logoCheminRelatif String?
  // Jours où l'association tient effectivement cours, utilisés pour limiter
  // les sélecteurs de jour à la création/modification d'une Cohorte (voir
  // Cohorte.jour) — donnée éditable depuis Administration → Organisation,
  // jamais un sous-ensemble figé de l'enum JourSemaine dans le code : ça
  // permet de rouvrir un jour plus tard sans migration (voir CLAUDE.md,
  // règles non négociables sur les décisions métier éditables).
  joursActifs       JourSemaine[] @default([MARDI, JEUDI, SAMEDI, DIMANCHE])
  misAJourLe        DateTime      @updatedAt

  @@map("organisation")
}

model Utilisateur {
  id             String    @id @default(cuid())
  email          String    @unique
  motDePasseHash String
  nom            String
  prenom         String
  role           Role
  actif          Boolean   @default(true)
  creeLe         DateTime  @default(now())
  dernierLogin   DateTime?

  sessions                            Session[]
  journalAudit                        JournalAudit[]
  classesEnseignees                   ClasseEnseignant[]
  seancesValidees                     Seance[]
  documentsAjoutes                    Document[]
  activitesCreees                     Activite[]
  activitesResponsable                ActiviteResponsable[]
  documentsAssociationAjoutes         DocumentAssociation[]
  codesPreinscriptionCrees            CodePreinscription[]
  lecturesNotificationsPreinscription LecturePreinscription[]
  lecturesNotificationsListeAttente   LectureListeAttente[]
  demandesCorrectionTraitees          DemandeCorrection[]
  // Spécialités déclarées d'un enseignant (Section dans laquelle il peut
  // intervenir), affectées à la création/modification du compte — sert à
  // filtrer les enseignants proposés lors de la création d'une classe (voir
  // lib/enseignants.ts), indépendamment de tout historique d'affectation.
  specialites                         Section[]               @relation("EnseignantSpecialites")

  @@map("utilisateurs")
}

// Sessions stockées en base (pas de JWT) : révocation immédiate possible
// (désactivation d'un utilisateur = invalidation de toutes ses sessions).
model Session {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  creeLe        DateTime    @default(now())
  expireLe      DateTime

  // Connexion faite en scannant le QR d'une classe (voir /qr/[token]) : cette
  // session ne donne accès qu'à la feuille de présence de CETTE séance, rien
  // d'autre dans l'appli, même en tapant une autre URL à la main — imposé
  // dans requireSession()/requireRole() (src/lib/auth.ts), le seul endroit
  // qui fait réellement foi pour l'accès. Null = session normale, sans
  // restriction.
  seanceRestreinteId String?
  seanceRestreinte   Seance? @relation(fields: [seanceRestreinteId], references: [id], onDelete: SetNull)

  @@index([utilisateurId])
  @@map("sessions")
}

model AnneeScolaire {
  id        String   @id @default(cuid())
  libelle   String   @unique // ex. "2026/2027"
  dateDebut DateTime
  dateFin   DateTime
  active    Boolean  @default(false)
  // Archivage de fin d'année : masque par défaut ses classes, séances et
  // dossiers annuels des vues actives (Classes, Présences, Paiements), sans
  // rien supprimer — un flag ici archive implicitement tout ce qui s'y
  // rattache (Classe, Seance via Classe, DossierAnnuel/Paiement via
  // Echeance), pas besoin de flag dupliqué sur chacun. Voir
  // Administration > Années scolaires.
  archivee  Boolean  @default(false)

  classes             Classe[]
  dossiersAnnuels     DossierAnnuel[]
  periodesFermeture   PeriodeFermeture[]
  affectationsCohorte AffectationCohorte[]

  @@map("annees_scolaires")
}

// Vacances et fermetures saisies en début d'année : aucune séance n'est
// générée sur ces dates. Complémentaire à l'annulation ponctuelle d'une
// séance (Seance.statut = ANNULEE) pour les imprévus.
model PeriodeFermeture {
  id              String        @id @default(cuid())
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
  libelle         String // ex. "Vacances de février"
  dateDebut       DateTime
  dateFin         DateTime
  creeLe          DateTime      @default(now())

  @@index([anneeScolaireId])
  @@map("periodes_fermeture")
}

// Fréquence de récurrence d'une Activite. Volontairement minimal (pas
// d'intervalle personnalisé type "tous les 2 mardis", pas de RRULE) : une
// activité récurrente génère une ligne Activite par occurrence au moment de
// la création (voir src/lib/activites.ts#datesOccurrencesActivite), toutes
// partageant le même serieId. Chaque occurrence reste ensuite modifiable/
// supprimable indépendamment, comme les Seance générées depuis une Classe.
enum FrequenceActivite {
  AUCUNE
  QUOTIDIENNE
  HEBDOMADAIRE
  MENSUELLE
}

// Événement associatif ponctuel ou récurrent (sortie, fête, réunion,
// examen...), affiché sur le calendrier aux côtés des cours (Seance) et des
// vacances (PeriodeFermeture), avec une couleur dédiée pour rester
// distinguable des cours d'un coup d'œil (voir (app)/calendrier/page.tsx).
// Le rappel (bandeau tableau de bord + pastille menu, RAPPEL_JOURS avant la
// date, voir src/lib/activites.ts) est géré entièrement par l'application,
// sans email ni dépendance à n8n (règle non négociable, voir
// Projet/04_Regles_non_negociables.md).
model Activite {
  id                String            @id @default(cuid())
  titre             String
  contenu           String?
  date              DateTime          @db.Date
  // Dernier jour d'UNE occurrence quand elle dure plusieurs jours consécutifs
  // (ex. un camp de 3 jours) ; null = activité d'une seule journée.
  dateFin           DateTime?         @db.Date
  heureDebut        String? // "HH:MM" ; null = journée entière, pas d'horaire précis
  heureFin          String?
  lieu              String?
  // Propriétés de la SÉRIE, dupliquées sur chaque occurrence générée pour
  // affichage/traçabilité (ex. "fait partie d'une série hebdomadaire
  // jusqu'au ..."), non réditables occurrence par occurrence après coup.
  frequence         FrequenceActivite @default(AUCUNE)
  dateFinRecurrence DateTime?         @db.Date
  serieId           String?

  creeParId    String?
  creePar      Utilisateur?          @relation(fields: [creeParId], references: [id], onDelete: SetNull)
  responsables ActiviteResponsable[]
  creeLe       DateTime              @default(now())
  modifieLe    DateTime              @updatedAt

  @@index([date])
  @@index([serieId])
  @@map("activites")
}

// Membres du staff désignés comme responsables/organisateurs d'une activité
// (plusieurs possibles, même principe que ClasseEnseignant pour les
// classes) : n'importe quel rôle staff, pas seulement Enseignant — une
// sortie associative est typiquement portée par le Bureau ou l'Accueil.
model ActiviteResponsable {
  activiteId    String
  activite      Activite    @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@id([activiteId, utilisateurId])
  @@map("activite_responsables")
}

enum Civilite {
  M
  MME
}

enum Sexe {
  F
  M
}

// PREINSCRIT : créé via le formulaire public de préinscription, en attente
// du contrôle sur place (signature, documents, paiement). VALIDE : dossier
// confirmé par le staff, ou créé directement en interne (valeur par défaut).
enum StatutInscription {
  PREINSCRIT
  VALIDE
}

// Fiche unique par personne (voir 02_Modele_metier.md, règle 1). L'historique
// des inscriptions/cours par année arrive avec les modèles Cours/Classe
// (phase suivante) ; cette table ne porte que l'identité et les coordonnées.
//
// Le champ `DDF` présent dans l'ancienne BDD Excel n'est pas repris : sa
// signification doit être confirmée avec l'association avant intégration
// (voir Projet/03_Analyse_existant_Excel.md, section 3.3). Ne pas deviner.
model Etudiant {
  id                             String            @id @default(cuid())
  // Identifiant métier stable, distinct du cuid technique ci-dessus (jamais
  // utilisé comme nom de dossier/fichier NAS — illisible pour l'accueil,
  // voir lib/documents-nommage.ts) : 6 chiffres, attribué une seule fois via
  // la séquence Postgres `etudiant_matricule_seq` (voir migration
  // ajoute_matricule_etudiant), jamais recalculé/réutilisé même après
  // suppression ou fusion de doublon. Immuable après attribution — garanti
  // par un trigger Postgres posé dans la même migration (pas seulement par
  // discipline de code : voir la fonction empecher_modification_matricule),
  // donc aucune action serveur ne doit jamais tenter de l'inclure dans un
  // payload de mise à jour, y compris fusionnerDoublonAction
  // (etudiants/[id]/actions.ts) où seule la fiche conservée compte, jamais
  // celle du doublon supprimé.
  // @default(dbgenerated(...)) plutôt qu'un défaut Prisma classique : la
  // valeur DOIT être calculée par la séquence côté Postgres (voir la
  // migration), jamais recalculée indépendamment côté application —
  // indique aussi au client généré que ce champ est optionnel à la création
  // (laissé au DEFAULT de la colonne), voir tous les `etudiant.create`.
  matricule                      String            @unique @default(dbgenerated("lpad((nextval('etudiant_matricule_seq'::regclass))::text, 6, '0'::text)")) @db.Char(6)
  civilite                       Civilite?
  nom                            String
  prenom                         String
  dateNaissance                  DateTime?
  villeNaissance                 String?
  telephoneMobile                String?
  telephoneFixe                  String?
  email                          String?
  adresse                        String?
  complementAdresse              String?
  codePostal                     String?
  ville                          String?
  contactUrgenceNom              String?
  contactUrgencePrenom           String?
  contactUrgenceTelephone        String?
  profession                     String?
  niveauEtudes                   String?
  dernierDiplome                 String?
  remarque                       String?
  statutInscription              StatutInscription @default(VALIDE)
  // Marqueur d'idempotence pour l'automatisation n8n (hors app, voir
  // CLAUDE.md section n8n) qui envoie l'email de bienvenue + dossier rempli
  // quand statutInscription bascule PREINSCRIT → VALIDE : n8n lit les
  // candidats via GET /api/internal/n8n/inscriptions-a-notifier (filtré sur
  // IS NULL) puis pose ce champ via POST
  // /api/internal/n8n/etudiants/[id]/notification-bienvenue après envoi
  // réussi, pour ne jamais renvoyer deux fois le même email. n8n ne touche
  // jamais directement Postgres — uniquement via ces routes internes (voir
  // lib/auth-n8n.ts).
  notificationBienvenueEnvoyeeLe DateTime?
  // Section demandée à la préinscription en ligne quand aucun créneau
  // n'était encore ouvert pour l'assigner directement à une classe (voir
  // preinscription/actions.ts) : reste affichée comme « à assigner » sur la
  // fiche jusqu'à ce que le staff inscrive effectivement l'étudiant à une
  // classe (voir inscrireEtudiantAction, qui l'efface alors).
  sectionSouhaiteeId             String?
  sectionSouhaitee               Section?          @relation(fields: [sectionSouhaiteeId], references: [id], onDelete: SetNull)
  // Carte de créneau (catalogue CreneauSection, ex. "S" samedi) choisie à la
  // préinscription pour sectionSouhaiteeId quand aucune Classe réelle
  // n'existait encore pour l'assigner directement (voir
  // preinscription/actions.ts) : sinon perdue silencieusement, alors que le
  // dossier papier demandait toujours ce choix. Affichée sur la fiche
  // jusqu'à l'inscription effective à une classe, qui l'efface (voir
  // inscrireEtudiantAction, même geste que sectionSouhaiteeId).
  creneauSouhaiteId              String?
  creneauSouhaite                CreneauSection?   @relation(fields: [creneauSouhaiteId], references: [id], onDelete: SetNull)
  // Niveau déclaré par la famille à la préinscription — choix unique parmi
  // le catalogue de la section choisie (voir Section.catalogueNiveaux,
  // src/lib/niveaux-section.ts ; ex. "Débutant"/"Intermédiaire" pour
  // Arabe/Coran, "1ère année"…"5ème année" pour Islamiques), obligatoire
  // quand ce catalogue n'est pas AUCUN (voir preinscription-form.tsx).
  // Jamais une FK vers Cohorte (pas de garantie qu'une Cohorte de ce niveau
  // existe déjà) : reste une déclaration affichée sur le dossier généré et
  // sur la fiche étudiant pour aider le staff à choisir la bonne cohorte au
  // moment de l'inscription effective (voir AffectationCohorte), jamais
  // déduite automatiquement de ce champ.
  niveauDeclare                  String?
  // Consentement à être filmé/photographié lors des activités de
  // l'association (case "Engagement" du dossier généré, voir
  // src/lib/dossier/context.ts et les templates .hbs) — question OBLIGATOIRE
  // du formulaire public de préinscription (voir preinscription-form.tsx),
  // toujours explicitement OUI ou NON, jamais un défaut implicite : ce champ
  // reste donc null pour toute fiche créée avant l'introduction de cette
  // question, ou créée manuellement par le staff (etudiants/nouveau/actions.ts,
  // hors périmètre de cette question) — un null se traduit par AUCUNE des
  // deux cases cochées sur le dossier (règle non négociable "ne jamais
  // deviner"), jamais par une case cochée par défaut. Conservé tel quel après
  // validation/signature du dossier : ce n'est pas un champ du cycle
  // DossierAnnuel (qui se réouvre chaque année scolaire), c'est une
  // information propre à l'étudiant, au même titre que sectionSouhaiteeId
  // ci-dessus, mais jamais effacée (contrairement à ce dernier) : un
  // consentement donné une fois reste valable, il n'est pas lié à une classe.
  autorisationPhotoVideo         Boolean?
  // Renseigné quand le Bureau anonymise manuellement un dossier inactif
  // depuis longtemps (RGPD — voir src/lib/rgpd.ts). Volontairement pas de
  // purge/tâche automatique : le CA n'a pas encore validé de politique de
  // rétention formelle, donc l'anonymisation reste un geste manuel par
  // dossier, déclenché depuis Administration > RGPD.
  anonymiseLe                    DateTime?
  // Utilisés uniquement par le dossier d'inscription du modèle Jeunes (voir
  // Section.modeleDossier) : sexe de l'élève et niveau scolaire suivi hors
  // association. Laissés vides pour un étudiant du modèle Adultes.
  sexe                           Sexe?
  niveauScolaire                 String?
  // Doublon potentiel détecté automatiquement à la préinscription publique
  // (clé nom + prénom + date de naissance, ou nom + prénom + téléphone/email
  // d'un responsable — voir preinscription/actions.ts#trouverDoublonEtudiant)
  // : pointe vers la fiche existante correspondante tant que le staff n'a
  // pas tranché — mise à jour de la fiche existante (fusion, voir
  // etudiants/[id]/actions.ts#fusionnerDoublonAction) ou confirmation qu'il
  // s'agit d'un homonyme distinct (#confirmerHomonymeAction), qui efface
  // simplement ce champ.
  doublonPotentielId             String?
  doublonPotentiel               Etudiant?         @relation("DoublonPotentiel", fields: [doublonPotentielId], references: [id], onDelete: SetNull)
  doublonsDetectes               Etudiant[]        @relation("DoublonPotentiel")
  // Date d'inscription affichée/modifiable sur la fiche étudiant (distincte
  // de `creeLe`, horodatage technique de création de la ligne jamais
  // corrigé) : posée explicitement à la création (préinscription ou saisie
  // manuelle, voir preinscription/actions.ts et etudiants/nouveau/actions.ts)
  // puis librement corrigible ensuite (ex. dossier papier saisi en retard).
  dateInscription                DateTime
  creeLe                         DateTime          @default(now())
  misAJourLe                     DateTime          @updatedAt

  responsables                ResponsableLegal[]
  dossiersAnnuels             DossierAnnuel[]
  inscriptions                InscriptionClasse[]
  presences                   Presence[]
  documents                   Document[]
  affectationsCohorte         AffectationCohorte[]
  notificationsPreinscription NotificationPreinscription[]

  @@index([nom, prenom])
  @@index([doublonPotentielId])
  @@map("etudiants")
}

// Parent/tuteur. Rattaché directement à l'étudiant : le partage d'un même
// responsable entre plusieurs étudiants (fratrie) n'est pas géré en Phase 1,
// faute de besoin confirmé — à revisiter si nécessaire.
model ResponsableLegal {
  id                     String    @id @default(cuid())
  etudiantId             String
  etudiant               Etudiant  @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  civilite               Civilite?
  nom                    String
  prenom                 String
  lien                   String // ex. "Père", "Mère", "Tuteur" — sert aussi à dériver la
  // case cochée (Père/Mère/Autre) et rl_relation_autre du dossier Jeunes,
  // sans champ dédié (voir src/lib/dossier/context.ts).
  telephone              String?
  telephoneProfessionnel String?
  email                  String?
  adresse                String?
  codePostal             String?
  ville                  String?
  profession             String?
  creeLe                 DateTime  @default(now())

  @@index([etudiantId])
  @@map("responsables_legaux")
}

enum TypeDocument {
  PIECE_IDENTITE
  PHOTO
  DOSSIER_GENERE
  DOSSIER_SIGNE
  JUSTIFICATIF_PAIEMENT
  ATTESTATION_SCOLARITE
  AUTRE
}

// Pièces d'identité acceptées — liste fixe, cohérente avec les autres enums
// de référence de l'appli plutôt qu'un texte libre.
enum TypePieceIdentite {
  CARTE_IDENTITE
  PASSEPORT
  TITRE_SEJOUR
  PERMIS_CONDUIRE
  AUTRE
}

// Fichiers stockés séparément de la base (DOCUMENTS_DIR, jamais en base —
// règle non négociable). Cette table ne porte que les métadonnées et le
// chemin relatif ; le fichier réel vit sur le disque/NAS.
model Document {
  id                String             @id @default(cuid())
  etudiantId        String
  etudiant          Etudiant           @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  type              TypeDocument
  // Renseignés uniquement quand type = PIECE_IDENTITE : nature de la pièce et
  // date d'expiration, pour savoir si elle reste valide sans redemander à la
  // famille (voir lib/documents.ts#statutDocumentsRequis et la fusion de
  // doublons dans etudiants/[id]/actions.ts).
  typePieceIdentite TypePieceIdentite?
  dateExpiration    DateTime?          @db.Date
  nomFichier        String
  cheminRelatif     String // relatif à DOCUMENTS_DIR
  mimeType          String
  tailleOctets      Int
  creeLe            DateTime           @default(now())
  creeParId         String?
  creePar           Utilisateur?       @relation(fields: [creeParId], references: [id], onDelete: SetNull)
  // Non nul uniquement pour la pièce d'identité du TITULAIRE d'un chèque
  // quand celui-ci n'est pas l'étudiant (voir Cheque.titulaireEstEtudiant) :
  // même modèle Document/DOCUMENTS_DIR réutilisé plutôt qu'un système à
  // part, distingué par ce champ pour ne pas fausser le dossier documentaire
  // de l'étudiant (toujours filtré à chequeId = null pour ce calcul).
  chequeId          String?
  cheque            Cheque?            @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  // Non nul uniquement pour type = DOSSIER_GENERE/DOSSIER_SIGNE : rattache
  // explicitement chaque génération au DossierAnnuel (année) qu'elle
  // représente — manquant jusqu'ici (une génération n'était retrouvable que
  // par etudiantId + tri par date, ambigu pour un étudiant réinscrit
  // plusieurs années). `numeroVersion` incrémente à chaque régénération
  // (correction d'un champ ordinaire, voir DossierAnnuel.versionConfirmeeNumero) ;
  // l'historique complet reste consultable, jamais écrasé (voir principe
  // "PDF = représentation générée, jamais source de vérité").
  dossierAnnuelId   String?
  dossierAnnuel     DossierAnnuel?     @relation(fields: [dossierAnnuelId], references: [id], onDelete: SetNull)
  numeroVersion     Int?
  // Non nul uniquement pour type = DOSSIER_GENERE : position exacte (page +
  // coordonnées en % de la page, voir lib/dossier/render.ts) des zones de
  // signature du PDF, mesurée dans le DOM au moment du rendu Puppeteer
  // (chaque .page étant une page fixe, jamais reflowée) plutôt que codée en
  // dur — corrige un champ de signature Documenso posé à un endroit sans
  // rapport avec les zones réelles du gabarit (voir lib/documenso.ts). Lu par
  // dossier/[token]/actions.ts#confirmerEtSignerAction au moment de l'envoi
  // à Documenso, sur la version exacte du PDF déjà confirmée par la famille.
  champsSignature   Json?
  // Non nul uniquement pour type = DOSSIER_GENERE, uniquement pour les
  // versions créées par la route de téléchargement staff
  // (etudiants/[id]/dossier/route.ts) : empreinte sha256 du HTML rendu juste
  // avant conversion PDF, pour éviter qu'un simple reclic sur "Télécharger"
  // sans aucune donnée modifiée n'empile une nouvelle version identique (le
  // PDF final, lui, n'est jamais byte-à-byte identique d'un rendu Chromium à
  // l'autre — métadonnées internes horodatées — donc inutilisable comme clé
  // de comparaison). `genererNouvelleVersionDossier` (flux de signature
  // famille) n'y touche pas : chaque appel y représente une correction de
  // champ réelle et doit toujours invalider la confirmation en cours, jamais
  // être dédupliqué.
  contenuHash       String?

  @@index([etudiantId])
  @@index([chequeId])
  @@index([dossierAnnuelId])
  @@map("documents")
}

// Lien sécurisé donnant à la famille l'accès à SON dossier, sans compte ni
// mot de passe — même principe que CodePreinscription/JetonPreinscriptionPermanent
// (seul le hash du token est stocké, jamais le token en clair), mais scopé
// à un DossierAnnuel précis plutôt qu'à l'entrée générale du formulaire.
// Un seul lien actif par dossier : une régénération (relance, fuite
// suspectée) réécrit ce tokenHash plutôt que d'empiler des lignes.
model AccesDossier {
  id              String        @id @default(cuid())
  dossierAnnuelId String        @unique
  dossierAnnuel   DossierAnnuel @relation(fields: [dossierAnnuelId], references: [id], onDelete: Cascade)
  tokenHash       String        @unique
  expireLe        DateTime
  // Non nul = lien invalidé manuellement par le staff (fuite suspectée) ou
  // remplacé par une régénération — distinct d'une simple expiration.
  revoqueLe       DateTime?
  dernierAccesLe  DateTime?
  creeLe          DateTime      @default(now())

  @@map("acces_dossier")
}

// Demande de correction sur un champ sensible (identité, date de naissance,
// responsable légal, etc. — voir liste figée côté application) qu'un
// étudiant/parent ne peut jamais modifier lui-même depuis /dossier/[token] :
// file d'exception traitée par le staff (voir Administration → Inscriptions),
// jamais un champ éditable directement en ligne. `message` = texte libre
// décrivant la correction souhaitée, saisi par la famille.
model DemandeCorrection {
  id              String        @id @default(cuid())
  dossierAnnuelId String
  dossierAnnuel   DossierAnnuel @relation(fields: [dossierAnnuelId], references: [id], onDelete: Cascade)
  message         String
  creeLe          DateTime      @default(now())
  traiteeLe       DateTime?
  traiteeParId    String?
  traiteePar      Utilisateur?  @relation(fields: [traiteeParId], references: [id], onDelete: SetNull)

  @@index([dossierAnnuelId])
  @@map("demandes_correction")
}

// Code d'accès pour la préinscription publique (voir /preinscription?code=...
// et src/lib/preinscription-code.ts) — jamais un verrou global sur
// /preinscription, n'entre en jeu QUE quand l'URL porte `?code=...`. Même
// principe que Session (voir plus haut) : seul le hash du code est stocké,
// jamais le code en clair (même fonction de hash que hashSessionToken).
//
// Deux origines, distinguées par `estAccueilAuto`, avec un mode de
// consommation différent (`usageUnique`) :
// - email (estAccueilAuto = false, usageUnique = true) : campagne ciblée, un
//   code généré à la main par le staff depuis *Inscriptions* pour une
//   famille précise — invalidé dès la première soumission réussie (via
//   `utiliseLe`), comme un lien à usage unique classique.
// - accueil (estAccueilAuto = true, usageUnique = false) : généré
//   automatiquement par GET /accueil-preinscription (voir
//   src/app/accueil-preinscription/route.ts), `expireLe` fixée à la fin de
//   la journée courante. Plusieurs familles scannant le même QR affiché sur
//   place le même jour doivent toutes pouvoir soumettre avec — jamais
//   consommé à la soumission (`utiliseLe` reste null), seule l'expiration
//   l'invalide. Le prochain GET après expiration en régénère un nouveau
//   paresseusement ; le staff peut aussi forcer cette régénération plus tôt
//   (ex. fuite suspectée) via `invaliderCodeAccueilAutoEnCours`, qui avance
//   `expireLe` à maintenant sans rien créer lui-même.
model CodePreinscription {
  id             String       @id @default(cuid())
  codeHash       String       @unique
  // Libellé libre (ex. "Relance rentrée 2026" pour un code email, "Accueil
  // (rotation automatique)" pour un code accueil) : sert uniquement au staff
  // pour se repérer dans Prisma Studio (pas d'écran de liste dédié, voir
  // CLAUDE.md sur l'absence de sur-ingénierie), aucun usage fonctionnel.
  campagneLabel  String
  expireLe       DateTime
  // true = généré automatiquement par GET /accueil-preinscription ; false =
  // généré à la main depuis *Inscriptions* pour une campagne email. Défaut à
  // false : un code existant (créé avant ce champ) reste un code email,
  // comportement inchangé.
  estAccueilAuto Boolean      @default(false)
  // Gouverne la consommation à la soumission (voir tenterConsommerCode) :
  // true = invalidé dès la première soumission réussie (`utiliseLe` posé) ;
  // false = jamais consommé, seule `expireLe` invalide le code — plusieurs
  // soumissions différentes peuvent donc réussir avec le même code tant
  // qu'il n'a pas expiré. Défaut à true : un code existant (créé avant ce
  // champ, donc forcément un code email) garde son comportement usage
  // unique inchangé. Toujours false pour un code accueil (estAccueilAuto).
  usageUnique    Boolean      @default(true)
  // Non nul dès la première soumission réussie de preinscrireAction avec un
  // code `usageUnique` (voir preinscription/actions.ts) — invalide le code
  // pour toute soumission suivante. Reste toujours null pour un code
  // `usageUnique = false` (accueil) : la présence de ce champ n'est donc
  // significative que combinée à `usageUnique`.
  utiliseLe      DateTime?
  creeLe         DateTime     @default(now())
  creeParId      String?
  creePar        Utilisateur? @relation(fields: [creeParId], references: [id], onDelete: SetNull)

  @@index([expireLe])
  @@map("codes_preinscription")
}

// Jeton permanent embarqué dans le QR officiel de préinscription publique
// (voir /inscriptions et ARCHITECTURE-PREINSCRIPTION.md) — volontairement
// distinct de CodePreinscription ci-dessus : celui-ci gère des codes à
// expiration/rotation (email, accueil), ce jeton-ci n'a ni l'un ni l'autre.
// Ce n'est pas un mécanisme d'authentification, seulement un filtre contre
// les robots qui découvriraient le hostname public sans être passés par le
// QR imprimé (voir src/lib/preinscription-token.ts). Un seul enregistrement
// en pratique — id fixe (`ID_SINGLETON` côté code) plutôt que @default(cuid()),
// pour que deux requêtes concurrentes de première création ne puissent pas
// produire deux jetons permanents valides à la fois.
model JetonPreinscriptionPermanent {
  id        String   @id
  // Contrairement à codeHash ci-dessus, le jeton est aussi stocké en clair
  // ici, en plus de son hash : ce n'est pas un secret au sens d'une session
  // ou d'un code email — il est destiné à être imprimé et affiché
  // publiquement sur le QR officiel. Le staff doit pouvoir réafficher
  // l'URL/QR complet à tout moment depuis *Inscriptions* (y compris après un
  // redémarrage du conteneur), sans jamais le régénérer — ce qui
  // invaliderait le QR déjà imprimé.
  jeton     String
  jetonHash String   @unique
  creeLe    DateTime @default(now())

  @@map("jetons_preinscription_permanents")
}

// Notification persistante d'une nouvelle préinscription (voir
// preinscription/actions.ts et (app)/inscriptions) — créée dans la même
// opération que l'Etudiant (écriture imbriquée Prisma, donc la même requête
// que l'INSERT de l'étudiant), jamais par un job séparé qui « découvrirait »
// après coup les nouvelles préinscriptions : Postgres reste la seule source
// de vérité, exactement comme le reste de l'app.
//
// État de lecture INDIVIDUEL par utilisateur (voir LecturePreinscription
// ci-dessous), volontairement pas un simple champ `luLe` global sur cette
// table : deux membres du staff doivent pouvoir avoir chacun leur propre
// état de lecture sur la même préinscription (voir src/lib/notifications-preinscription.ts).
//
// Les destinataires ne sont jamais stockés ici, ni sur aucune table : ils
// sont déterminés dynamiquement à la lecture via la grille de permissions
// (peutAccederModule(role, Module.INSCRIPTIONS, "LECTURE")), exactement
// comme la visibilité du menu ((app)/layout.tsx) — pas de liste
// d'utilisateurs codée en dur, pas de table de fan-out à la création.
model NotificationPreinscription {
  id                String    @id @default(cuid())
  etudiantId        String
  etudiant          Etudiant  @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  creeLe            DateTime  @default(now())
  // Marqueur d'idempotence pour le flux n8n « alerte staff nouvelle
  // préinscription » (même patron que Etudiant.notificationBienvenueEnvoyeeLe
  // plus haut) : posé par POST .../email-envoye après envoi réussi, jamais
  // par l'application elle-même — l'app ne dépend jamais de ce champ pour
  // fonctionner (voir CLAUDE.md, l'app doit fonctionner intégralement sans
  // n8n). Distinct du flux existant `inscriptions-a-notifier` : celui-ci
  // notifie la FAMILLE après validation du dossier, celui-ci alerte le
  // STAFF dès l'arrivée d'une préinscription — deux flux indépendants.
  notifieParEmailLe DateTime?

  lectures LecturePreinscription[]

  @@index([notifieParEmailLe])
  @@map("notifications_preinscription")
}

// Une ligne = « cet utilisateur a lu cette notification ». Absence de ligne
// = non lue pour lui. Modélise volontairement un état DE LECTURE PAR
// UTILISATEUR plutôt qu'un simple champ luLe global sur
// NotificationPreinscription (voir son commentaire ci-dessus).
model LecturePreinscription {
  id             String                     @id @default(cuid())
  notificationId String
  notification   NotificationPreinscription @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  utilisateurId  String
  utilisateur    Utilisateur                @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  luLe           DateTime                   @default(now())

  @@unique([notificationId, utilisateurId])
  @@map("lectures_notification_preinscription")
}

// Les 4 sections de l'association (Jeunes, Études Islamiques, Langue Arabe,
// Études Coraniques), reprises des dossiers d'inscription papier 2025-2026.
// Tarification et volume horaire par section, pas par cours : c'est ainsi
// que l'association facture (voir Projet/Dossiers-inscriptions).
//
// Barème de remboursement en cas d'annulation après le début des cours,
// propre à chaque section (ex. Jeunes : 75%/50%, Adultes : 50%/25%) :
// - avant le début des cours : 100% des frais de formation (implicite,
//   les frais de dossier ne sont eux jamais remboursés) ;
// - entre le 1er et le 15e jour après le début : remboursementAvant15Jours ;
// - entre le 15e et le 29e jour après le début : remboursementAvant29Jours ;
// - après le 29e jour : 0% (implicite).
// Modèle maître de dossier d'inscription utilisé par la section (voir
// src/lib/dossier/templates/) : ADULTES pour Études Coraniques/Islamiques/
// Langue Arabe et toute future formation adulte, JEUNES pour la Formation
// Jeunes et ses futurs équivalents. Un seul gabarit par modèle, jamais
// dupliqué par section (voir CLAUDE.md et Projet/Dossiers-inscriptions).
enum ModeleDossier {
  ADULTES
  JEUNES
}

// Catalogue de niveaux proposé à la préinscription pour choisir la section
// (voir Section.catalogueNiveaux, src/lib/niveaux-section.ts) : AUCUN pour
// une section sans notion de niveau (ex. Jeunes, qui a son propre
// niveauScolaire libre), DEBUTANT_INTERMEDIAIRE pour Langue Arabe/Études
// Coraniques, ANNEES_1_A_5 pour Études Islamiques — mêmes exigences que
// modeleDossier ci-dessus : un catalogue fixe par valeur d'enum, jamais une
// liste de niveaux éditable en texte libre (le choix associatif porte sur
// QUEL catalogue s'applique à une section, pas sur son contenu).
enum CatalogueNiveaux {
  AUCUN
  DEBUTANT_INTERMEDIAIRE
  ANNEES_1_A_5
}

model Section {
  id                        String           @id @default(cuid())
  nom                       String           @unique
  fraisFormation            Decimal          @db.Decimal(10, 2)
  fraisDossier              Decimal          @db.Decimal(10, 2)
  volumeHoraireAnnuel       Int? // heures indicatives par an, ex. 120
  remboursementAvant15Jours Int // % des frais de formation remboursé
  remboursementAvant29Jours Int // % des frais de formation remboursé
  modeleDossier             ModeleDossier    @default(ADULTES)
  // Catalogue de niveaux à cocher obligatoirement à la préinscription pour
  // cette section (voir preinscription-form.tsx, Etudiant.niveauDeclare) :
  // AUCUN désactive le champ pour cette section.
  catalogueNiveaux          CatalogueNiveaux @default(AUCUN)
  // Dispositions propres à la section affichées dans le règlement du
  // dossier généré (bloc "Dispositions propres à la section", visible
  // seulement si non vide) — donnée éditable par l'association, jamais une
  // règle écrite en dur dans le template (voir CLAUDE.md, règles non
  // négociables).
  reglesSpecifiques         String[]         @default([])
  creeLe                    DateTime         @default(now())

  cours                   Cours[]
  cohortes                Cohorte[]
  souhaitsPreinscription  Etudiant[]
  enseignantsSpecialistes Utilisateur[]    @relation("EnseignantSpecialites")
  creneaux                CreneauSection[]

  @@map("sections")
}

// Catalogue des créneaux proposés à l'inscription pour une section (ex. "CS"
// cours du soir, "S" samedi, "D" dimanche pour les Adultes ; un seul créneau
// pour Jeunes) — reproduit les "cartes de créneau" du dossier papier/PDF.
// Distinct du créneau réel d'une Classe (Classe.jour/heureDebut/heureFin) :
// celui-ci est une donnée de catalogue affichée sur le dossier, pas un
// planning. La carte correspondant à la Classe réellement suivie par
// l'étudiant est cochée au mieux à la génération (voir
// src/lib/dossier/context.ts), sans garantie de correspondance stricte.
model CreneauSection {
  id          String  @id @default(cuid())
  sectionId   String
  section     Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  code        String // "CS", "S", "D"...
  jour        String // "Dimanche", "mardi et jeudi"...
  horaire     String // "09h00 – 13h00"
  restriction String? // ex. "Seulement 1ʳᵉ année"
  ordre       Int     @default(0)

  etudiantsSouhaitant Etudiant[]

  @@index([sectionId])
  @@map("creneaux_section")
}

// Un cours peut être enseigné par plusieurs classes/groupes (ex. plusieurs
// créneaux/niveaux du même cours). Ne pas confondre avec Classe : le cours
// est la matière, la classe est le groupe concret relié au planning.
model Cours {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  nom         String   @unique
  description String?
  creeLe      DateTime @default(now())

  cohortesLiees CohorteCours[]
  classes       Classe[]

  @@index([sectionId])
  @@map("cours")
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

// Salle physique où se déroulent les cours — entité propre plutôt qu'un
// champ texte libre sur Classe, car elle porte désormais le QR permanent
// affiché en salle (voir Classe.salle ci-dessous et /qr/[token]) : un texte
// libre aurait cassé le rapprochement du QR au moindre typo/renommage entre
// deux classes de la même salle réelle. Le QR est fixe pour la salle, ne
// contient aucune donnée personnelle, et n'est qu'un raccourci d'accès :
// jamais une authentification (règle non négociable).
// capaciteMax : plafond physique de la pièce (chaises/espace), null =
// illimité. Portée par la Salle plutôt que par la Cohorte (voir
// Cohorte.capaciteMax retiré — migration 20260914... — et
// AffectationCohorte plus bas) : la capacité est une contrainte du lieu, pas
// du groupe d'élèves qui l'occupe, et devait cesser de dépendre d'un chiffre
// ressaisi manuellement par bloc. Toujours éditable depuis
// Administration → Salles, jamais une constante en dur (règle non
// négociable, voir CLAUDE.md).
model Salle {
  id          String   @id @default(cuid())
  nom         String   @unique
  qrToken     String   @unique @default(cuid())
  capaciteMax Int?
  creeLe      DateTime @default(now())

  classes Classe[]

  @@map("salles")
}

// Catalogue amont Section + Niveau + Jour (ex. "Études Islamiques — Deuxième
// année — Samedi"), créé une fois et réutilisé d'année en année. L'identité
// de la Cohorte est autosuffisante — Section+niveau+jour — et existe
// indépendamment de tout Cours : une Cohorte se crée d'abord (même sans
// aucun cours), puis des Cours lui sont affectés au fil du temps (voir
// CohorteCours), jamais l'inverse. Cas réel qui motive le multi-cours : le
// même groupe d'enfants, même salle, même jour, tourne entre plusieurs
// matières/profs sur le créneau (ex. Biographie du Prophète 9h, Fiqh 10h,
// Foi islamique 11h) — chaque Cours affecté garde sa propre Classe (horaire
// précis, salle, enseignants, semestre — voir Classe.coursId), les Classes
// ne fusionnent jamais entre elles. Un Cours affecté doit appartenir à la
// Section de la Cohorte (vérifié en application, voir classes/actions.ts) ;
// changer la Section d'une Cohorte qui a déjà des cours/classes est bloqué
// (COHORTE_SECTION_VERROUILLEE). Pas de champ nom stocké : le libellé est
// calculé partout à l'affichage à partir de section.nom + niveau +
// JOUR_LABELS[jour].
//
// La capacité/liste d'attente d'un bloc (voir AffectationCohorte plus bas)
// est dérivée en application de la Salle des Classes de la Cohorte pour
// l'année scolaire consultée (Salle.capaciteMax), plus du champ propre ici
// (retiré — migration 20260826101940_retire_capacite_et_liste_attente
// l'avait introduit au niveau Classe, un premier passage l'avait remonté ici
// avant ce nouveau déplacement vers Salle) : la capacité est une contrainte
// physique de la pièce, pas du groupe. Conséquence appliquée en code
// (classes/nouveau/actions.ts, classes/[id]/actions.ts) plutôt qu'en
// contrainte SQL : les Classes d'une même Cohorte pour une même
// AnneeScolaire doivent toutes pointer vers la même Salle (ou aucune) — voir
// src/lib/cohortes.ts pour la résolution de cette capacité.
model Cohorte {
  id        String      @id @default(cuid())
  sectionId String
  section   Section     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  niveau    String?
  jour      JourSemaine
  creeLe    DateTime    @default(now())

  coursLies    CohorteCours[]
  classes      Classe[]
  affectations AffectationCohorte[]

  @@unique([sectionId, niveau, jour])
  @@index([sectionId])
  @@map("cohortes")
}

// Table de liaison Cohorte × Cours (many-to-many explicite plutôt
// qu'implicite, pour porter un ordre d'affichage — ex. "Biographie du
// Prophète + Fiqh + Foi islamique" dans l'ordre du créneau).
model CohorteCours {
  cohorteId String
  cohorte   Cohorte @relation(fields: [cohorteId], references: [id], onDelete: Cascade)
  coursId   String
  cours     Cours   @relation(fields: [coursId], references: [id], onDelete: Restrict)
  ordre     Int     @default(0)

  @@id([cohorteId, coursId])
  @@index([coursId])
  @@map("cohorte_cours")
}

// Groupe concret relié au planning (voir 03_Analyse_existant_Excel.md §3.5 :
// ne jamais stocker la classe comme simple texte sur l'étudiant).
//
// Décisions MVP validées avec l'association :
// - niveau = attribut texte simple, porté par la Cohorte (pas de référentiel
//   séparé) ;
// - un seul créneau hebdomadaire par classe (jour porté par la Cohorte,
//   heure début/fin propres à la Classe) ;
// - plusieurs enseignants possibles par classe (table de liaison) ;
// - une salle accueille plusieurs classes au fil d'une journée : le QR
//   d'accès rapide est donc porté par la Salle (permanent, un seul code
//   affiché quels que soient les cours qui s'y succèdent), pas par la
//   Classe — voir /qr/[token] et src/lib/qr.ts pour la résolution de la
//   séance du jour au moment du scan.
model Classe {
  id              String        @id @default(cuid())
  cohorteId       String
  cohorte         Cohorte       @relation(fields: [cohorteId], references: [id], onDelete: Restrict)
  // Cours précis que CETTE Classe instancie au sein du bloc Cohorte (ex. la
  // Classe "9h" instancie "Biographie du Prophète" dans la Cohorte "Études
  // Islamiques Niveau 1 Samedi") — nécessaire depuis que Cohorte peut porter
  // plusieurs Cours (voir Cohorte, CohorteCours) : avant, le Cours se
  // déduisait implicitement de Cohorte.coursId (unique). Doit référencer un
  // Cours effectivement lié à cohorteId, vérifié en application (pas de
  // contrainte SQL composite, pour ne pas complexifier inutilement le
  // schéma), voir classes/[id]/actions.ts et classes/nouveau/actions.ts.
  coursId         String
  cours           Cours         @relation(fields: [coursId], references: [id], onDelete: Restrict)
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Restrict)
  semestre        String? // ex. "1", "2" ; null = classe valable toute l'année
  heureDebut      String // "HH:MM"
  heureFin        String // "HH:MM"
  salleId         String?
  salle           Salle?        @relation(fields: [salleId], references: [id], onDelete: SetNull)
  creeLe          DateTime      @default(now())

  enseignants  ClasseEnseignant[]
  inscriptions InscriptionClasse[]
  seances      Seance[]

  @@index([anneeScolaireId])
  @@index([cohorteId])
  @@index([coursId])
  @@index([salleId])
  @@map("classes")
}

// « Participation à un cours » du modèle métier, en version minimale : le
// rattachement d'un étudiant à une classe, nécessaire pour constituer la
// liste d'appel. L'inscription complète (dossier, documents, validation)
// reste Phase 2, en attente du gabarit du dossier officiel. Pas de capacité
// ni de liste d'attente à ce niveau : toute InscriptionClasse créée est
// immédiatement effective. La capacité/liste d'attente vivent au niveau
// Cohorte (voir AffectationCohorte) : une fois un étudiant affecté à une
// Cohorte, une InscriptionClasse est créée pour chacune de ses Classes sans
// contrôle de place supplémentaire ici.
model InscriptionClasse {
  id         String   @id @default(cuid())
  etudiantId String
  etudiant   Etudiant @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  classeId   String
  classe     Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  creeLe     DateTime @default(now())

  @@unique([etudiantId, classeId])
  @@index([classeId])
  @@map("inscriptions_classe")
}

enum StatutAffectationCohorte {
  AFFECTE
  EN_ATTENTE
}

// Affectation d'un étudiant à une Cohorte pour une année scolaire donnée :
// porte la capacité/liste d'attente au niveau du bloc, capacité résolue via
// la Salle de ses Classes pour cette même année (voir Salle.capaciteMax,
// src/lib/cohortes.ts), scopée par année puisque Cohorte elle-même n'est pas
// rattachée à une année (réutilisable d'année en année). Choix explicite du
// staff au moment de la création du DossierAnnuel (voir
// paiements/nouveau/actions.ts#creerDossierAction) : jamais déduit
// automatiquement du créneau souhaité de préinscription
// (Etudiant.sectionSouhaiteeId/creneauSouhaiteId pointent vers un catalogue
// générique Section/CreneauSection, sans lien exploitable vers une Cohorte
// précise).
//
// AFFECTE : une InscriptionClasse a été créée (fan-out) pour CHAQUE Classe
// rattachée à cette Cohorte pour anneeScolaireId — tout ou rien, pas de
// désinscription partielle d'un seul Cours du bloc en gardant les autres.
// EN_ATTENTE : capaciteMax atteinte au moment de la demande. Le passage à
// AFFECTE reste toujours manuel (jamais automatique, même quand une place se
// libère — voir classes/cohortes/actions.ts#promouvoirAffectationCohorteAction),
// pour laisser le staff arbitrer explicitement.
model AffectationCohorte {
  id               String                   @id @default(cuid())
  cohorteId        String
  cohorte          Cohorte                  @relation(fields: [cohorteId], references: [id], onDelete: Cascade)
  etudiantId       String
  etudiant         Etudiant                 @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  anneeScolaireId  String
  anneeScolaire    AnneeScolaire            @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
  statut           StatutAffectationCohorte @default(AFFECTE)
  // Position dans la liste d'attente pour un tri stable indépendant de
  // creeLe (utile si deux affectations sont créées dans la même
  // transaction/même milliseconde) — incrémenté au sein de (cohorteId,
  // anneeScolaireId).
  rangListeAttente Int?
  creeLe           DateTime                 @default(now())

  // Une notification est créée quand cette affectation naît EN_ATTENTE (voir
  // src/lib/cohortes.ts#affecterEtudiantACohorte), jamais quand elle naît
  // directement AFFECTE — pas de notification pour une place obtenue du
  // premier coup. Jamais recréée ni supprimée à la promotion (voir
  // promouvoirAffectationCohorteAction) : son caractère « actif » est
  // entièrement dérivé du statut courant de cette même affectation (même
  // philosophie que NotificationPreinscription/Etudiant.statutInscription
  // ci-dessous), pas un second état à resynchroniser. Supprimée seulement en
  // cascade si l'affectation elle-même est retirée
  // (retirerAffectationCohorteAction).
  notification NotificationListeAttente?

  @@unique([etudiantId, cohorteId, anneeScolaireId])
  @@index([cohorteId, anneeScolaireId, statut])
  @@map("affectations_cohorte")
}

// Alerte staff « un étudiant vient de passer en liste d'attente », affichée
// dans la cloche du Topbar et sur le Dashboard (voir
// src/lib/notifications-liste-attente.ts) — même patron que
// NotificationPreinscription/LecturePreinscription plus haut : lu/non-lu
// individuel par utilisateur (LectureListeAttente), « active » tant que
// l'AffectationCohorte liée est toujours EN_ATTENTE (dérivé à la lecture,
// jamais un flag dupliqué à maintenir).
model NotificationListeAttente {
  id                   String             @id @default(cuid())
  affectationCohorteId String             @unique
  affectationCohorte   AffectationCohorte @relation(fields: [affectationCohorteId], references: [id], onDelete: Cascade)
  creeLe               DateTime           @default(now())

  lectures LectureListeAttente[]

  @@map("notifications_liste_attente")
}

// Une ligne = « cet utilisateur a lu cette notification de liste d'attente »
// (voir LecturePreinscription pour la même logique côté préinscriptions).
model LectureListeAttente {
  id             String                    @id @default(cuid())
  notificationId String
  notification   NotificationListeAttente  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  utilisateurId  String
  utilisateur    Utilisateur               @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  luLe           DateTime                  @default(now())

  @@unique([notificationId, utilisateurId])
  @@map("lectures_notification_liste_attente")
}

model ClasseEnseignant {
  classeId      String
  classe        Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@id([classeId, utilisateurId])
  @@map("classe_enseignants")
}

enum StatutSeance {
  PREVUE
  VALIDEE
  ANNULEE
}

// Séances générées depuis le planning de la classe (règle 7), en sautant les
// périodes de fermeture. Une séance peut aussi être annulée ponctuellement.
model Seance {
  id              String       @id @default(cuid())
  classeId        String
  classe          Classe       @relation(fields: [classeId], references: [id], onDelete: Cascade)
  date            DateTime     @db.Date
  statut          StatutSeance @default(PREVUE)
  motifAnnulation String?
  valideeLe       DateTime?
  valideeParId    String?
  valideePar      Utilisateur? @relation(fields: [valideeParId], references: [id], onDelete: SetNull)
  // Trace la saisie a posteriori depuis la feuille papier de secours, pour
  // distinguer une validation faite en séance d'une reprise administrative.
  saisieViaPapier Boolean      @default(false)
  creeLe          DateTime     @default(now())

  presences           Presence[]
  sessionsRestreintes Session[]

  @@unique([classeId, date])
  @@index([date])
  @@map("seances")
}

// Statuts repris de l'existant (Modele présence.xlsx) : P, R, RE, A, AE.
enum StatutPresence {
  PRESENT
  RETARD
  RETARD_EXCUSE
  ABSENT
  ABSENT_EXCUSE
}

// Une présence par étudiant et par séance. Ne jamais deviner les absents
// (règle non négociable) : les présences ne sont écrites qu'au moment où
// l'enseignant valide explicitement la feuille.
model Presence {
  id         String         @id @default(cuid())
  seanceId   String
  seance     Seance         @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  etudiantId String
  etudiant   Etudiant       @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  statut     StatutPresence
  misAJourLe DateTime       @updatedAt

  @@unique([seanceId, etudiantId])
  @@index([etudiantId])
  @@map("presences")
}

enum MoyenPaiement {
  ESPECES
  CHEQUE
  VIREMENT
  CB
  PRELEVEMENT
}

// Réglage éditable (Administration → Relances), une seule ligne, sur le même
// principe que Organisation : jamais de constante en dur pour une décision
// associative (voir CLAUDE.md — "ne jamais changer silencieusement une
// règle métier"). Consommé par GET /api/internal/n8n/dossiers-a-relancer
// (flux n8n de relance paiement/pièce d'identité, hors app).
model ParametresRelance {
  id                            String   @id @default(cuid())
  // Nombre maximum de relances automatiques envoyées par dossier annuel :
  // au-delà, le flux n8n ne le remonte plus, le staff reprend la main
  // manuellement depuis la fiche.
  nombreMaxRelances             Int      @default(2)
  // Jours d'attente avant la première relance (depuis DossierAnnuel.creeLe)
  // puis entre deux relances (depuis DossierAnnuel.derniereRelanceEnvoyeeLe).
  delaiJours                    Int      @default(15)
  // Réglage d'un flux distinct (alerte interne Bureau quand un chèque reçu
  // traîne non déposé, voir Cheque.nombreAlertesEnvoyees) : même mécanique
  // que nombreMaxRelances/delaiJours ci-dessus mais volontairement des
  // champs séparés — ce n'est pas la même règle métier (famille vs
  // trésorerie interne), donc jamais couplés.
  nombreMaxAlertesCheque        Int      @default(2)
  delaiJoursCheque              Int      @default(7)
  // Réglage d'un 3e flux, sans rapport avec les deux précédents (rapport
  // hebdomadaire/mensuel effectifs + trésorerie au Bureau) : nombre de
  // semaines après le 1er septembre calendaire (voir
  // debutAnneeScolaireCalendaireUTC dans src/lib/calendrier.ts) pendant
  // lesquelles la cadence reste hebdomadaire (envoi le lundi) ; au-delà,
  // cadence mensuelle (envoi le dernier jour du mois, y compris l'été). Ancré
  // sur le calendrier plutôt que sur AnneeScolaire.dateDebut (rentrée
  // pédagogique, souvent fin septembre/octobre) car les inscriptions
  // démarrent avant la rentrée effective des classes.
  dureeIntensiveRapportSemaines Int      @default(6)
  misAJourLe                    DateTime @updatedAt

  @@map("parametres_relance")
}

// Ancrage minimal pour les paiements (montant dû global saisi à la main),
// en attendant l'inscription complète (préinscription, cours suivis,
// génération du dossier officiel — Phase 2, en attente du gabarit). La
// tarification par section existe désormais (voir Section) mais le calcul
// automatique du montant dû à partir des sections/cours suivis reste à
// faire (Phase 2) ; en attendant, montantDu est saisi manuellement.
model DossierAnnuel {
  id                       String        @id @default(cuid())
  etudiantId               String
  etudiant                 Etudiant      @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  anneeScolaireId          String
  anneeScolaire            AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Restrict)
  montantDu                Decimal       @db.Decimal(10, 2)
  // Basculé manuellement par le Trésorier/Bureau quand la cotisation a été
  // remboursée à la famille : prime sur le statut calculé (soldé/partiel/
  // impayé) pour l'affichage, sans toucher aux échéances/paiements déjà
  // enregistrés (traçabilité conservée).
  rembourse                Boolean       @default(false)
  // Renseigné à la main par l'administration pour le dossier Jeunes (case
  // "Réservé à l'administration — Niveau d'admission"), sans équivalent côté
  // Adultes. Reste vide tant que non saisi.
  niveauAdmission          String?
  creeLe                   DateTime      @default(now())
  // Idempotence + compteur du flux n8n de relance (voir ParametresRelance et
  // GET/POST /api/internal/n8n/dossiers-a-relancer|.../relance-envoyee) :
  // incrémenté seulement après l'envoi réussi d'une relance, jamais avant.
  // Volontairement pas basé sur le statut Soldé/Partiel/Impayé (voir
  // lib/paiements.ts#statutCotisation, qui reflète l'encaissement réel en
  // trésorerie) : la relance ne regarde que si au moins un paiement a été
  // apporté, peu importe son état de traitement.
  nombreRelancesEnvoyees   Int           @default(0)
  derniereRelanceEnvoyeeLe DateTime?

  // --- Parcours dossier → vérification → signature (Documenso) ---
  // Version confirmée par la famille (voir Document.numeroVersion pour
  // l'historique complet des PDF générés) : la signature ne peut jamais
  // porter sur une version différente de celle-ci. Remise à null par toute
  // modification d'un champ ordinaire après confirmation (voir
  // src/app/dossier/[token]/actions.ts) — invalide la confirmation
  // précédente, oblige une nouvelle vérification avant de pouvoir signer à
  // nouveau.
  versionConfirmeeNumero            Int?
  versionConfirmeeLe                DateTime?
  statutSignature                   StatutSignature @default(A_GENERER)
  // Identifiant numérique du document côté Documenso (voir
  // src/lib/documenso.ts) — Documenso reste le seul moteur de signature,
  // l'app ne fait jamais confiance à un statut local sans confirmation par
  // webhook (voir api/webhooks/documenso).
  documensoDocumentId               Int?            @unique
  envoyeSignatureLe                 DateTime?
  signeLe                           DateTime?
  // Idempotence du flux n8n "dossier prêt à vérifier" (même patron que
  // NotificationPreinscription.notifieParEmailLe) : posé uniquement par
  // POST /api/internal/n8n/dossiers-a-verifier/.../notifie après envoi
  // réussi.
  notificationVerificationEnvoyeeLe DateTime?
  // Idempotence du flux n8n "signature confirmée" (même patron que
  // notificationVerificationEnvoyeeLe ci-dessus) : posé uniquement par
  // POST /api/internal/n8n/etudiants/[etudiantId]/notification-signature-confirmee
  // après envoi réussi. Ne peut être renseigné qu'une fois statutSignature =
  // SIGNEE (posé exclusivement par le webhook Documenso, jamais deviné).
  notificationSignatureEnvoyeeLe    DateTime?

  echeances          Echeance[]
  documents          Document[]
  accesDossier       AccesDossier?
  demandesCorrection DemandeCorrection[]

  @@unique([etudiantId, anneeScolaireId])
  @@map("dossiers_annuels")
}

// Trois familles d'états volontairement séparées plutôt qu'un seul gros
// enum (voir CLAUDE.md/analyse de conversation) :
// - StatutInscription (Etudiant, déjà existant) : validation administrative
//   finale, indépendante de la signature ;
// - StatutSignature (ici) : cycle du dossier généré jusqu'à la signature
//   Documenso ;
// - AffectationCohorte.statut (déjà existant) : affectation pédagogique.
// Ces trois axes peuvent avancer dans n'importe quel ordre (voir règle
// "signature ≠ validation finale").
enum StatutSignature {
  A_GENERER // pas encore de dossier généré, ou contrôles pas encore passés
  A_VERIFIER // dossier généré, en attente de vérification/confirmation famille
  ENVOYEE_SIGNATURE // confirmé par la famille, transmis à Documenso
  SIGNEE
}

model Echeance {
  id              String        @id @default(cuid())
  dossierAnnuelId String
  dossierAnnuel   DossierAnnuel @relation(fields: [dossierAnnuelId], references: [id], onDelete: Cascade)
  libelle         String?
  montant         Decimal       @db.Decimal(10, 2)
  dateEcheance    DateTime
  creeLe          DateTime      @default(now())

  paiements Paiement[]

  @@index([dossierAnnuelId])
  @@map("echeances")
}

model Paiement {
  id           String        @id @default(cuid())
  echeanceId   String
  echeance     Echeance      @relation(fields: [echeanceId], references: [id], onDelete: Cascade)
  moyen        MoyenPaiement
  montant      Decimal       @db.Decimal(10, 2)
  datePaiement DateTime      @default(now())
  creeLe       DateTime      @default(now())

  cheque      Cheque?
  prelevement Prelevement?

  // Mouvement de trésorerie généré automatiquement à la saisie du paiement
  // (voir getOuCreerCategorieCotisations, src/lib/tresorerie.ts) — jamais
  // recréé/dupliqué grâce à la contrainte unique côté MouvementTresorerie.
  mouvementTresorerie MouvementTresorerie?

  @@index([echeanceId])
  @@map("paiements")
}

enum StatutCheque {
  RECU
  DEPOSE
  ENCAISSE
  REJETE
}

// Détails spécifiques au chèque, en 1-1 avec le paiement (uniquement quand
// Paiement.moyen = CHEQUE).
model Cheque {
  id                      String       @id @default(cuid())
  paiementId              String       @unique
  paiement                Paiement     @relation(fields: [paiementId], references: [id], onDelete: Cascade)
  banque                  String?
  numero                  String?
  titulaireNom            String?
  titulairePrenom         String?
  // true = le titulaire est l'étudiant lui-même (cas par défaut) : dans ce
  // cas on ne redemande pas une seconde pièce d'identité, celle du dossier
  // étudiant suffit. false = tiers payeur (ex. grand-parent) : nom/prénom
  // distincts + pièce d'identité dédiée (voir Document.chequeId).
  titulaireEstEtudiant    Boolean      @default(true)
  statut                  StatutCheque @default(RECU)
  dateDepot               DateTime?
  dateEncaissement        DateTime?
  motifRejet              String?
  // Idempotence + compteur du flux n8n d'alerte "chèque reçu non déposé"
  // (voir ParametresRelance et GET/POST /api/internal/n8n/cheques-a-alerter
  // |.../alerte-envoyee) : incrémenté seulement après l'envoi réussi d'une
  // alerte, jamais avant. N'a de sens que tant que statut = RECU — dès que
  // le chèque passe à DEPOSE/ENCAISSE/REJETE, il sort du champ de la requête
  // du flux, ces compteurs restent alors figés (traçabilité, jamais remis à
  // zéro).
  nombreAlertesEnvoyees   Int          @default(0)
  derniereAlerteEnvoyeeLe DateTime?

  documents Document[]

  @@map("cheques")
}

enum StatutPrelevement {
  EMIS
  ENCAISSE
  REJETE
}

// Détails spécifiques au prélèvement SEPA, en 1-1 avec le paiement
// (uniquement quand Paiement.moyen = PRELEVEMENT). Même principe de cycle
// que Cheque.statut, mais sans étape de dépôt physique en banque (le
// prélèvement est déjà transmis à la banque dès la saisie) : EMIS (transmis,
// par défaut) → ENCAISSE / REJETE, avec motifRejet symétrique à
// `Cheque.motifRejet` pour le suivi des incidents de paiement (voir
// lib/paiements.ts#incidentDePaiement, (app)/paiements/[id]).
model Prelevement {
  id               String            @id @default(cuid())
  paiementId       String            @unique
  paiement         Paiement          @relation(fields: [paiementId], references: [id], onDelete: Cascade)
  iban             String?
  bic              String?
  titulaire        String?
  referenceMandat  String?
  statut           StatutPrelevement @default(EMIS)
  dateEncaissement DateTime?
  motifRejet       String?

  @@map("prelevements")
}

enum TypeMouvement {
  RECETTE
  DEPENSE
}

// Liste éditable par le Bureau plutôt que texte libre, pour garder les
// mouvements exploitables en rapport (voir Projet/03_Analyse_existant_Excel.md §5).
model CategorieMouvement {
  id     String   @id @default(cuid())
  nom    String   @unique
  // Clé technique stable pour les catégories gérées par le système (ex.
  // "Cotisations" créée par getOuCreerCategorieCotisations) : le lien
  // automatique repose dessus, jamais sur `nom`, pour survivre à un
  // renommage depuis Administration → Trésorerie. Null pour une catégorie
  // créée librement par le Bureau.
  cle    String?  @unique
  actif  Boolean  @default(true)
  creeLe DateTime @default(now())

  mouvements MouvementTresorerie[]

  @@map("categories_mouvement")
}

// Trésorerie volontairement simple (pas de comptabilité complète) : le solde
// est calculé en cumul à la lecture, jamais stocké.
model MouvementTresorerie {
  id           String              @id @default(cuid())
  date         DateTime
  libelle      String
  type         TypeMouvement
  moyen        MoyenPaiement
  montant      Decimal             @db.Decimal(10, 2)
  categorieId  String?
  categorie    CategorieMouvement? @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  justificatif String? // chemin/référence du fichier séparé, pas de contenu en base
  // Non nul quand ce mouvement a été généré automatiquement depuis un
  // paiement (voir enregistrerPaiementAction) : le mouvement devient alors
  // en lecture seule côté Trésorerie, la correction passe par la fiche
  // paiement (voir modifierPaiementAction, qui resynchronise le montant).
  paiementId   String?             @unique
  paiement     Paiement?           @relation(fields: [paiementId], references: [id], onDelete: SetNull)
  creeLe       DateTime            @default(now())

  @@index([date])
  @@map("mouvements_tresorerie")
}

// Traçabilité transverse (validation dossier, modification présence validée,
// saisie paiement, etc.) — alimentée au fil des phases suivantes.
model JournalAudit {
  id            String       @id @default(cuid())
  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  action        String
  entite        String
  entiteId      String?
  details       Json?
  horodatage    DateTime     @default(now())

  @@index([utilisateurId])
  @@index([entite, entiteId])
  @@map("journal_audit")
}

// Phase 6 : gouvernance associative (CA/AG), réservée de fait au Bureau —
// module GOUVERNANCE dans la grille de permissions (aucune ligne par défaut
// => AUCUN pour tous les autres rôles, BUREAU court-circuité comme partout
// ailleurs). Les membres du CA n'ont pas de compte applicatif : ce module
// n'est utilisé que par le Bureau, qui gère PV/convocations en dehors de
// l'app pour les autres membres.
model MembreCA {
  id         String    @id @default(cuid())
  nom        String
  prenom     String
  fonction   String? // ex. "Président", "Secrétaire", "Trésorier", "Membre" — texte libre
  email      String?
  dateEntree DateTime
  dateSortie DateTime?
  creeLe     DateTime  @default(now())

  @@map("membres_ca")
}

enum TypeReunionGouvernance {
  CA
  AG
  BUREAU
}

model ReunionGouvernance {
  id          String                 @id @default(cuid())
  type        TypeReunionGouvernance
  date        DateTime
  ordreDuJour String?
  creeLe      DateTime               @default(now())

  documents DocumentAssociation[]

  @@index([date])
  @@map("reunions_gouvernance")
}

enum TypeDocumentAssociation {
  PV
  REGLEMENT_INTERIEUR
  STATUTS
  AUTRE
}

// Fichiers séparés de la base, comme Document (voir plus haut) : seules les
// métadonnées et le chemin relatif à DOCUMENTS_DIR sont stockés ici. Table
// distincte de Document (qui est spécifique aux étudiants, etudiantId non
// nul) plutôt que de la rendre générique — évite de complexifier le modèle
// existant pour un besoin différent (documents associatifs, pas de dossier
// étudiant).
model DocumentAssociation {
  id            String                  @id @default(cuid())
  type          TypeDocumentAssociation
  nomFichier    String
  cheminRelatif String
  mimeType      String
  tailleOctets  Int
  reunionId     String?
  reunion       ReunionGouvernance?     @relation(fields: [reunionId], references: [id], onDelete: SetNull)
  creeLe        DateTime                @default(now())
  creeParId     String?
  creePar       Utilisateur?            @relation(fields: [creeParId], references: [id], onDelete: SetNull)

  @@index([reunionId])
  @@map("documents_association")
}
